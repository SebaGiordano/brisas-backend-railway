@model BrisasDeOro.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Brisas de Oro</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #171512;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            padding: 1.5rem;
        }
        .login-card {
            background-color: #f5f2ec;
            border-radius: 12px;
            padding: 3rem 3rem 2.5rem;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, .4);
        }
        @@media (max-width: 480px) {
            .login-card {
                max-width: 340px;
                padding: 2.25rem 1.75rem 2rem;
            }
        }
        .login-logo {
            width: 64px;
            height: 64px;
            background-color: #171512;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
        }
        .login-logo span {
            font-family: 'Playfair Display', Georgia, serif;
            font-weight: 700;
            font-size: 1.75rem;
            color: #c19a44;
        }
        .login-title {
            font-family: 'Playfair Display', Georgia, serif;
            font-weight: 600;
            font-size: 1.85rem;
            color: #171512;
            text-align: center;
            margin-bottom: .25rem;
        }
        .login-subtitle {
            text-align: center;
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .12em;
            color: #a08d6a;
            text-transform: uppercase;
            margin-bottom: 2rem;
        }
        .login-label {
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #5c5548;
            margin-bottom: .4rem;
            display: block;
        }
        .login-input {
            border: 1px solid #ded7c8 !important;
            border-radius: 8px !important;
            padding: .7rem .9rem !important;
            font-size: .95rem !important;
            background-color: #fff !important;
        }
        .login-input:focus {
            border-color: #c19a44 !important;
            box-shadow: 0 0 0 .2rem rgba(193, 154, 68, .18) !important;
        }
        .login-check-label {
            font-size: .85rem;
            color: #5c5548;
        }
        .btn-login {
            background-color: #0d6efd;
            border-color: #0d6efd;
            color: #fff;
            font-weight: 600;
            padding: .75rem;
            border-radius: 8px;
            font-size: .95rem;
        }
        .btn-login:hover {
            background-color: #0b5ed7;
            border-color: #0b5ed7;
            color: #fff;
        }
        .login-alert:empty {
            display: none;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-logo"><span>B</span></div>
        <div class="login-title">Brisas de Oro</div>
        <div class="login-subtitle">Panel de gestión</div>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div class="mb-3">
                <label asp-for="UserName" class="login-label">Usuario</label>
                <input asp-for="UserName" class="form-control login-input" placeholder="Tu nombre de usuario" autocomplete="username" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="login-label">Contraseña</label>
                <input asp-for="Password" class="form-control login-input" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label login-check-label">Recordarme</label>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-login">Ingresar</button>
            </div>
        </form>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="modal fade" id="modal-login-error" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
                <div class="modal-content" style="border-radius:12px; border:none;">
                    <div class="modal-body text-center p-4">
                        <div class="mb-3" style="font-size:2.5rem; color:#dc3545;">
                            <i class="bi bi-exclamation-circle-fill"></i>
                        </div>
                        <h6 class="fw-bold mb-2" style="color:#171512;">Usuario o contraseña incorrectos</h6>
                        <p class="text-muted small mb-4">Volvé a intentarlo con tus datos de acceso.</p>
                        <button type="button" class="btn btn-login w-100" data-bs-dismiss="modal">Entendido</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (!ViewData.ModelState.IsValid)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                new bootstrap.Modal(document.getElementById('modal-login-error')).show();
            });
        </script>
    }
</body>
</html>
