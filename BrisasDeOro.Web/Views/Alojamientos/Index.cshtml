@model List<AlojamientoListItemViewModel>
@{
    ViewData["Title"] = "Alojamientos";

    static string NombreTipo(TipoAlojamiento t) => t switch
    {
        TipoAlojamiento.Habitacion => "Habitación",
        TipoAlojamiento.Cabaña     => "Cabaña",
        TipoAlojamiento.Apart      => "Apart",
        _                          => t.ToString()
    };

    static string ClaseTipo(TipoAlojamiento t) => t switch
    {
        TipoAlojamiento.Habitacion => "bg-primary",
        TipoAlojamiento.Cabaña     => "bg-success",
        TipoAlojamiento.Apart      => "bg-info text-dark",
        _                          => "bg-secondary"
    };
}

<style>
    .filtro-tipo-aloj { transition: background-color .15s ease, color .15s ease, border-color .15s ease; }
    /* Azul activo uniforme — mismo tono que Tarifas */
    .filtro-tipo-aloj.active {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
    }
    /* Hover gris claro y sutil en los filtros no seleccionados */
    .filtro-tipo-aloj:not(.active):hover {
        background-color: #e9ecef !important;
        border-color: #ced4da !important;
        color: #495057 !important;
    }
    /* Nombre en el modal de confirmación: en su propio renglón, en una sola
       línea salvo que no entre (último recurso: se corta por cualquier punto). */
    .modal-nombre-confirmacion { overflow-wrap: anywhere; }
    @@media (max-width: 767.98px) {
        .tabla-aloj-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        /* Columnas ajustadas al contenido (no estiradas a todo el ancho), igual
           criterio que #tabla-pagos en el detalle de reserva. */
        .tabla-aloj-responsive table { width: max-content !important; min-width: 100% !important; }
        .tabla-aloj-responsive td,
        .tabla-aloj-responsive th { white-space: nowrap; padding: 0.5rem 0.325rem; }
        /* Con columna Acciones (Administrador): la tabla mide el ancho visible del
           contenedor + el ancho fijo de Acciones (100px), con table-layout:fixed.
           Así las primeras 4 columnas (Nombre/Tipo/Capacidad/Estado) se reparten
           exactamente el 100% visible y Acciones queda oculta hasta deslizar.
           Los porcentajes de cada columna están calibrados según el contenido más
           ancho de cada una (medido en el navegador): Nombre "Casa (Icho Cruz)",
           Tipo "Habitación", Capacidad "10 personas", Estado "Inactivo". */
        .tabla-aloj-responsive table.tabla-aloj-5col {
            width: calc(100% + 100px) !important;
            min-width: 0 !important;
            table-layout: fixed;
        }
        /* Los anchos de columna se fijan en px por JS (ver @@section Scripts): bajo
           table-layout:fixed, Chromium no respeta de forma confiable un calc() que
           mezcle % y px para dimensionar columnas (solo valores en px puros). */
        .tabla-aloj-5col thead th:nth-child(5) { width: 100px; }
        .tabla-aloj-5col td,
        .tabla-aloj-5col th { overflow: hidden; }
        /* Filtros: mismo criterio que .filtros-tipo-tarifas en Tarifas — título arriba,
           botones abajo repartiendo todo el ancho en partes iguales, sin scroll. */
        .filtros-aloj-sticky {
            width: 100% !important; flex-wrap: wrap !important; gap: 4px !important;
        }
        .filtros-aloj-sticky > span { width: 100%; margin-bottom: 2px; }
        .filtros-aloj-sticky .filtro-tipo-aloj {
            flex: 1 !important; font-size: 12px !important; padding: 5px 4px !important;
            display: flex !important; align-items: center !important; justify-content: center !important;
            white-space: nowrap;
        }
        /* Botones de acciones con ícono centrado */
        .tabla-aloj-responsive .btn { display: inline-flex !important; align-items: center; justify-content: center; }
        /* Modal de confirmación: altura adaptada al contenido */
        #modal-desactivar-aloj .modal-dialog  { min-height: unset !important; }
        #modal-desactivar-aloj .modal-content { height: auto !important; min-height: unset !important; max-height: 90vh !important; }
        #modal-desactivar-aloj .modal-footer  { padding-bottom: .75rem !important; }
    }
</style>

@* ── Encabezado ── *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Alojamientos</h2>
</div>

@* ── Filtro por tipo ── *@
<div class="d-flex align-items-center gap-2 flex-wrap mb-3 filtros-aloj-sticky">
    <span class="text-muted small fw-semibold">Filtrar por tipo:</span>
    <button type="button" class="btn btn-primary btn-sm filtro-tipo-aloj active" data-filtro="">Todos</button>
    <button type="button" class="btn btn-outline-secondary btn-sm filtro-tipo-aloj" data-filtro="Habitacion">Habitación</button>
    <button type="button" class="btn btn-outline-secondary btn-sm filtro-tipo-aloj" data-filtro="Apart">Apart</button>
    <button type="button" class="btn btn-outline-secondary btn-sm filtro-tipo-aloj" data-filtro="Cabaña">Cabaña</button>
    <button type="button" class="btn btn-outline-secondary btn-sm filtro-tipo-aloj" data-filtro="Casa">Casa</button>
</div>

@* ── Mensajes TempData ── *@
@if (TempData["Mensaje"] != null || TempData["MensajeDestacado"] != null)
{
    var tipo = TempData["MensajeTipo"]?.ToString() ?? "success";
    <div class="alert alert-@tipo alert-dismissible fade show" role="alert">
        <i class="bi bi-@(tipo == "success" ? "check-circle" : "exclamation-triangle") me-2"></i>
        @if (TempData["MensajeDestacado"] != null)
        {
            @TempData["MensajePrefijo"]<strong>@TempData["MensajeDestacado"]</strong>@TempData["MensajeSufijo"]
        }
        else
        {
            @TempData["Mensaje"]
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ── Tabla ── *@
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive tabla-aloj-responsive">
            <table class="table table-sm table-hover align-middle mb-0 @(User.IsInRole("Administrador") ? "tabla-aloj-5col" : "")">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th class="text-center">Tipo</th>
                        <th class="text-center">Capacidad</th>
                        <th class="text-center">Estado</th>
                        @if (User.IsInRole("Administrador"))
                        {
                            <th class="text-center">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr class="@(!a.Activo ? "table-secondary text-muted" : "")" data-tipo="@a.Tipo">
                            <td class="fw-semibold">@a.Nombre</td>
                            <td class="text-center">
                                <span class="badge @ClaseTipo(a.Tipo)">@NombreTipo(a.Tipo)</span>
                            </td>
                            <td class="text-center">@a.Capacidad personas</td>
                            <td class="text-center">
                                @if (a.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            @if (User.IsInRole("Administrador"))
                            {
                                <td class="text-center text-nowrap">
                                    <a asp-action="Editar" asp-route-id="@a.Id"
                                       class="btn btn-outline-primary btn-sm" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (a.Activo)
                                    {
                                        <form asp-action="Desactivar" asp-route-id="@a.Id"
                                              method="post" class="d-inline" id="form-desactivar-aloj-@a.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-outline-warning btn-sm btn-abrir-desactivar-aloj"
                                                    title="Desactivar"
                                                    data-nombre="@a.Nombre"
                                                    data-form="form-desactivar-aloj-@a.Id">
                                                <i class="bi bi-eye-slash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activar" asp-route-id="@a.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success btn-sm" title="Activar">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-md-none text-center text-muted scroll-hint" style="font-size:11px;">← Deslizá para ver más →</div>
    </div>
</div>
<div class="text-muted small mt-2">
    @Model.Count alojamiento@(Model.Count != 1 ? "s" : "") registrado@(Model.Count != 1 ? "s" : "")
    · @Model.Count(a => a.Activo) activo@(Model.Count(a => a.Activo) != 1 ? "s" : "")
</div>

@* ── Modal: Confirmar desactivación ── *@
<div class="modal fade" id="modal-desactivar-aloj" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-semibold">Desactivar alojamiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">¿Querés desactivar este alojamiento?</p>
                <p class="mb-2 fw-bold modal-nombre-confirmacion" id="desactivar-aloj-nombre"></p>
                <p class="mb-0">No aparecerá en el formulario de nueva reserva hasta que sea reactivado.</p>
            </div>
            <div class="modal-footer">
                <div class="d-flex gap-2 w-100">
                    <button type="button" class="btn btn-modal-cancelar flex-fill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-warning flex-fill" id="btn-confirmar-desactivar-aloj">Desactivar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    let _formDesactivarAloj = null;
    document.querySelectorAll('.btn-abrir-desactivar-aloj').forEach(btn => {
        btn.addEventListener('click', function () {
            document.getElementById('desactivar-aloj-nombre').textContent = this.dataset.nombre;
            _formDesactivarAloj = document.getElementById(this.dataset.form);
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-desactivar-aloj')).show();
        });
    });
    document.getElementById('btn-confirmar-desactivar-aloj')?.addEventListener('click', function () {
        bootstrap.Modal.getInstance(document.getElementById('modal-desactivar-aloj')).hide();
        _formDesactivarAloj?.submit();
    });
})();
(function () {
    const botones = document.querySelectorAll('.filtro-tipo-aloj');
    const filas   = document.querySelectorAll('tbody tr[data-tipo]');

    botones.forEach(btn => {
        btn.addEventListener('click', () => {
            const filtro = btn.dataset.filtro;
            botones.forEach(b => { b.className = 'btn btn-outline-secondary btn-sm filtro-tipo-aloj'; });
            btn.className = 'btn btn-primary btn-sm filtro-tipo-aloj active';
            filas.forEach(tr => {
                tr.style.display = (!filtro || tr.dataset.tipo === filtro) ? '' : 'none';
            });
        });
    });
})();

// ── Mobile: anchos de columna de la tabla de Alojamientos (con Acciones) ───────
// Bajo table-layout:fixed, el navegador no reparte de forma confiable un calc()
// que mezcle % y px al dimensionar columnas — se calculan y aplican en px puros.
(function () {
    const tabla = document.querySelector('table.tabla-aloj-5col');
    if (!tabla) return;

    const ANCHO_ACCIONES = 100; // px, fijo (botones Editar + Activar/Desactivar)
    // Proporciones calibradas según el contenido más ancho de cada columna:
    // Nombre "Casa (Icho Cruz)", Tipo "Habitación", Capacidad "10 personas",
    // Estado "Inactivo" (ver comentario en el <style> de arriba).
    const PROPORCIONES = [0.3258, 0.2308, 0.2534, 0.19];

    function aplicarAnchos() {
        if (window.innerWidth >= 768) return;
        const contenedor = tabla.closest('.tabla-aloj-responsive');
        if (!contenedor) return;
        const anchoDisponible = contenedor.clientWidth;
        const ths = tabla.querySelectorAll('thead th');
        PROPORCIONES.forEach((p, i) => {
            if (ths[i]) ths[i].style.width = Math.round(anchoDisponible * p) + 'px';
        });
        if (ths[4]) ths[4].style.width = ANCHO_ACCIONES + 'px';
    }

    aplicarAnchos();
    let resizeTimeout;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(aplicarAnchos, 100);
    });
})();
</script>
}
