@model InicioViewModel
@{
    ViewData["Title"] = "Inicio";

    string FmtFecha(DateOnly d) => d.ToString("dd/MM/yyyy");

    string AbrevAloj(string n) =>
        n.StartsWith("Habitación ") ? "Hab. " + n.Substring("Habitación ".Length) :
        n.StartsWith("Apart ")      ? "Ap. "  + n.Substring("Apart ".Length) :
        n.StartsWith("Cabaña ")     ? "Cab. " + n.Substring("Cabaña ".Length) :
        n;
}

<style>
    /* Tabla de limpieza: contener siempre el contenido dentro de la tarjeta.
       table-layout:fixed evita que un badge de texto largo (white-space: nowrap
       por defecto de Bootstrap) fuerce a la tabla a crecer más allá de su columna
       y se desborde sobre el bloque vecino en anchos intermedios (992–1399px). */
    #tabla-limpieza { table-layout: fixed; width: 100%; }
    #tabla-limpieza td:last-child,
    #tabla-limpieza th:last-child { word-wrap: break-word; overflow-wrap: break-word; }
    #tabla-limpieza .badge { white-space: normal; }
    /* Fila de grupo (colspan): no hereda el ancho fijo de la primera columna. padding-left
       fijado en px (!important): site.css define html{font-size:14px} por defecto y solo
       sube a 16px desde 768px, por lo que "p-2" (0.5rem) rendía 7px o 8px según el ancho de
       pantalla y desalineaba unos píxeles las reservas grupales contra las individuales
       (que usan valores fijos en px). Fijar aquí en px anula esa dependencia del rem. */
    #tabla-limpieza td.td-limpieza-grupo { width: auto; white-space: normal; padding-left: 8px !important; }
    /* Grid de unidades dentro de un grupo: columna de nombre con ancho fijo (no "auto")
       para que TODOS los grupos del bloque —cada uno es un grid CSS independiente—
       alineen exactamente en el mismo punto horizontal, y para que todas las unidades
       (habitaciones de Apart, habitaciones simples, cabañas) compartan la misma sangría.
       Solo el subtítulo "Apart N" (grid-column:1/-1) queda sin sangría, a propósito.
       column-gap en 16px: punto intermedio entre el valor original (12px, muy poco) y
       un ajuste previo de 20px (demasiado, notorio en pantallas chicas como 380px). */
    .grid-limpieza-grupo { grid-template-columns: 136px 1fr; row-gap: .4rem; column-gap: 16px; }
    /* Nombre de unidad indentada dentro de un grupo (habitación de Apart, habitación
       simple o cabaña): "ps-3" (1rem) fijado aquí en px por el mismo motivo de arriba,
       para que la sangría (8px del bloque + 16px = 24px) sea idéntica en todo ancho de
       pantalla a la de una reserva individual (ver .td-nombre-individual más abajo). */
    .grid-limpieza-grupo .ps-3 { padding-left: 16px !important; }
    /* Unidad (columna 1, en todas las resoluciones): nowrap para que el ancho fijo de
       140px (ver <th style="width:140px">) sea siempre respetado. */
    #tabla-limpieza td:first-child,
    #tabla-limpieza th:first-child { white-space: nowrap; }
    /* Unidad de reserva normal (no agrupada): misma sangría izquierda (fija en px, ver
       comentario arriba) que las unidades indentadas dentro de un grupo (8px + 16px =
       24px), para que ambos tipos de reserva arranquen en el mismo punto horizontal
       en todo ancho de pantalla. */
    #tabla-limpieza tbody > tr > td.td-nombre-individual { padding-left: 24px !important; }
    /* Encabezado "Tareas" y tareas de reserva individual: "ps-3" (1rem, variable con el
       font-size raíz) reemplazado por un valor fijo en px para que el punto de arranque
       (140px de columna + 20px = 160px) coincida exactamente, en todo ancho de pantalla,
       con el de las tareas dentro de un grupo (8px + 136px + 16px de column-gap = 160px). */
    #tabla-limpieza thead th.ps-3,
    #tabla-limpieza tbody > tr > td.ps-3 { padding-left: 20px !important; }
    /* Pantallas muy chicas (<=575px): gap/padding entre nombre y tarea reducido de forma
       proporcional en ambos mecanismos (grid de grupo y celdas de reserva individual)
       para mantener la alineación mientras se acercan visualmente las dos columnas. Las
       instalaciones (columna de nombres) no se ven afectadas, solo el espacio hacia la tarea. */
    @@media (max-width: 575px) {
        .grid-limpieza-grupo { column-gap: 10px !important; }
        #tabla-limpieza thead th.ps-3,
        #tabla-limpieza tbody > tr > td.ps-3 { padding-left: 14px !important; }
    }
    /* Pantallas aún más chicas (<=501px): reducir todavía más ese mismo gap/padding
       (manteniendo la misma correspondencia numérica que arriba: 8px del bloque + 136px
       del grid + Xpx de column-gap = 140px de columna + [X+4]px de padding), corriendo
       toda la columna de "Tareas" —encabezado y descripciones— un poco más a la
       izquierda. Va después de la regla de 575px para ganarle en la cascada cuando
       ambas apliquen. Las unidades no se tocan: mantienen su sangría de 24px. */
    @@media (max-width: 501px) {
        .grid-limpieza-grupo { column-gap: 6px !important; }
        #tabla-limpieza thead th.ps-3,
        #tabla-limpieza tbody > tr > td.ps-3 { padding-left: 10px !important; }
    }

    @@media (max-width: 991.98px) {
        /* Botones "Ver": ancho fijo uniforme, alineados al eje vertical derecho */
        .btn-sm.py-0 {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            min-width: 52px !important;
            width: 52px !important;
            padding-left: .5rem !important;
            padding-right: .5rem !important;
            margin-left: auto !important;
            font-weight: bold !important;
        }
        /* Pendientes: monto en rojo en negrita */
        td.text-end.fw-semibold.text-danger { font-weight: bold !important; }
        /* Pendientes: botón "Ver" en negrita */
        .btn-outline-danger.btn-sm.py-0 { font-weight: bold !important; }
        /* Badges numéricos de encabezados: centrado vertical */
        .badge { display: inline-flex !important; align-items: center !important; vertical-align: middle !important; }
        /* Todas las secciones con botón "Ver": padding-right igualado al de Pendientes (.25rem) */
        .lista-ver-items .list-group-item { padding-right: .25rem !important; }
        /* Pendientes: padding-left del titular igualado al de las demás secciones (1rem) */
        .tabla-pendientes tbody td:first-child,
        .tabla-pendientes thead th:first-child { padding-left: 1rem !important; }
        /* Badges de alojamiento por sección */
        .aloj-badge-checkin,
        .aloj-badge-checkout-hoy,
        .aloj-badge-manana,
        .aloj-badge-pendiente {
            border-radius: .375rem !important;
            padding: 2px 6px !important;
            font-size: .75em !important;
            font-weight: 700 !important;
            display: inline-block !important;
        }
        .aloj-badge-checkin      { background-color: #198754 !important; color: #fff !important; }
        .aloj-badge-checkout-hoy { background-color: #ffc107 !important; color: #212529 !important; }
        .aloj-badge-manana       { background-color: #ffc107 !important; color: #212529 !important; }
        .aloj-badge-pendiente    { background-color: #dc3545 !important; color: #fff !important; }
        /* Igualar font-size de HOY/MAÑANA en las tres tarjetas stat: el <strong> dentro de
           un <span> hereda 14px (regla global de span en site.css) mientras que el <strong>
           hijo directo del div .small hereda 12px. Se fija 12px para los tres por igual. */
        .card-stat-inicio .text-muted strong { font-size: 12px !important; }
        /* Extender el ocultamiento de columnas d-mobile-none hasta 991px en este módulo */
        .d-mobile-none { display: none !important; }
    }
    /* Padding-bottom ampliado en el bloque de grupo para separarlo del siguiente */
    .td-limpieza-grupo { padding-bottom: .85rem !important; }
    @@media (min-width: 992px) {
        /* Badges de alojamiento en desktop */
        .aloj-badge-checkin,
        .aloj-badge-checkout-hoy,
        .aloj-badge-manana {
            border-radius: .375rem;
            padding: 2px 8px;
            font-size: .8em;
            font-weight: 600;
            display: inline-block;
        }
        .aloj-badge-checkin                    { background-color: #198754; color: #fff; }
        .aloj-badge-checkout-hoy,
        .aloj-badge-manana                     { background-color: #ffc107; color: #212529; }
        /* Saldo pendiente: negrita */
        td.text-end.fw-semibold.text-danger    { font-weight: bold !important; }
        /* Botones "Ver": negrita */
        .btn-sm.py-0                           { font-weight: bold !important; }
        /* Pendientes: padding-right de la celda Ver igualado a list-group-item (1rem) */
        .tabla-pendientes tbody td:first-child,
        .tabla-pendientes thead th:first-child { padding-left: 1rem !important; }
        .tabla-pendientes tbody td:last-child  { padding-right: 1rem !important; }
    }

    /* ── Hover gris claro y sutil en filas de Limpieza del día ─────────────── */
    #tabla-limpieza > tbody > tr {
        transition: background-color .15s ease;
    }
    #tabla-limpieza > tbody > tr:hover > td {
        background-color: rgba(0, 0, 0, .03);
    }

    /* ── Hover gris claro en filas de Check-ins / Check-outs ───────────────── */
    .lista-ver-items .list-group-item {
        transition: background-color .15s ease;
    }
    .lista-ver-items .list-group-item:hover {
        background-color: rgba(0, 0, 0, .03);
    }

    /* ── Hover en negrita en los nombres del bloque Estado de unidades ─────── */
    .lista-unidades-estado li.small:hover {
        font-weight: 700;
        cursor: default;
    }

    /* ── Hover de elevación (sombra dorada suave) en tarjetas de estadísticas ─ */
    .card-stat-inicio {
        transition: box-shadow .2s ease, transform .2s ease;
    }
    .card-stat-inicio:hover {
        box-shadow: 0 .3rem .9rem rgba(195, 155, 45, .28);
        transform: translateY(-2px);
    }
</style>

@* ── Encabezado ── *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Panel de inicio</h2>
</div>

@* ══════════════════════════════════════════════════════════════
   SECCIÓN HOY
   ══════════════════════════════════════════════════════════════ *@
<h5 class="text-uppercase text-muted fw-semibold mb-3" style="letter-spacing:.06em; font-size:1.1rem;">
    <i class="bi bi-calendar3 me-1" style="color:#212529;"></i><strong>Hoy</strong> — @FmtFecha(Model.Hoy)
</h5>

@* ── Fila 1: Check-ins / Check-outs hoy ── *@
<div class="row g-3 mb-3">
    @* Check-ins hoy *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold bg-success bg-opacity-10 text-success-emphasis">
                <i class="bi bi-box-arrow-in-right me-1"></i>Check-ins de <strong>HOY</strong>
                <span class="badge bg-success ms-2">@Model.CheckInsHoy.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.CheckInsHoy.Any())
                {
                    <p class="text-muted fst-italic p-3 mb-0">Sin check-ins para hoy.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush lista-ver-items">
                        @foreach (var item in Model.CheckInsHoy)
                        {
                            @if (item.EsGrupal)
                            {
                                <li class="list-group-item d-flex align-items-start gap-2 py-2">
                                    <span class="fw-semibold flex-shrink-0">@item.NombreHuesped</span>
                                    <span class="d-flex flex-column gap-1 flex-fill ps-3">
                                        @foreach (var u in item.NombresUnidadesGrupales)
                                        {
                                            <span class="aloj-badge-checkin" style="width:fit-content;">@u</span>
                                        }
                                    </span>
                                    <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.ReservaId"
                                       class="btn btn-outline-secondary btn-sm py-0 flex-shrink-0">Ver</a>
                                </li>
                            }
                            else
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                    <span>
                                        <span class="fw-semibold">@item.NombreHuesped</span>
                                        <span class="ms-1 aloj-badge-checkin">@item.NombreAlojamiento</span>
                                    </span>
                                    <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.ReservaId"
                                       class="btn btn-outline-secondary btn-sm py-0">Ver</a>
                                </li>
                            }
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    @* Check-outs hoy *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold bg-warning bg-opacity-10 text-warning-emphasis">
                <i class="bi bi-box-arrow-right me-1"></i>Check-outs de <strong>HOY</strong>
                <span class="badge bg-warning text-dark ms-2">@Model.CheckOutsHoy.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.CheckOutsHoy.Any())
                {
                    <p class="text-muted fst-italic p-3 mb-0">Sin check-outs para hoy.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush lista-ver-items">
                        @foreach (var item in Model.CheckOutsHoy)
                        {
                            @if (item.EsGrupal)
                            {
                                <li class="list-group-item d-flex align-items-start gap-2 py-2">
                                    <span class="fw-semibold flex-shrink-0">@item.NombreHuesped</span>
                                    <span class="d-flex flex-column gap-1 flex-fill ps-3">
                                        @foreach (var u in item.NombresUnidadesGrupales)
                                        {
                                            <span class="aloj-badge-checkout-hoy" style="width:fit-content;">@u</span>
                                        }
                                    </span>
                                    <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.ReservaId"
                                       class="btn btn-outline-secondary btn-sm py-0 flex-shrink-0">Ver</a>
                                </li>
                            }
                            else
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                    <span>
                                        <span class="fw-semibold">@item.NombreHuesped</span>
                                        <span class="ms-1 aloj-badge-checkout-hoy">@item.NombreAlojamiento</span>
                                    </span>
                                    <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.ReservaId"
                                       class="btn btn-outline-secondary btn-sm py-0">Ver</a>
                                </li>
                            }
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@* ── Zona media: izquierda apilada (stats + limpieza) / derecha unidades libres ── *@
@{
    var habitacionesLibres = Model.UnidadesLibresHoy.Where(n => n.StartsWith("Habitación")).ToList();
    var cabañasLibres      = Model.UnidadesLibresHoy.Where(n => n.StartsWith("Cabaña")).ToList();
}
<div class="row g-3 mb-3" style="align-items:stretch;">

    @* ── Columna izquierda: stats + limpieza ── *@
    <div class="col-lg-6 d-flex flex-column gap-3">

        @* Stats — tres tarjetas: col-12 en mobile (≤991px), col-lg-4 en desktop (≥992px) *@
        <div class="row g-3">
            <div class="col-12 col-lg-4 d-flex">
                <div class="card text-center flex-grow-1 card-stat-inicio">
                    <div class="card-body py-3 d-flex flex-column justify-content-center">
                        <div class="display-6 fw-bold text-primary">@Model.PlazasOcupadasHoy</div>
                        <div class="text-muted small mt-1">
                            <span class="d-none d-lg-block">Plazas ocupadas<br><strong>HOY</strong><br><span class="fst-italic">(Sin invitaciones)</span></span>
                            <span class="d-lg-none">Plazas ocupadas <strong>HOY</strong><br><span class="fst-italic">(sin invitaciones)</span></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4 d-flex">
                <div class="card text-center flex-grow-1 card-stat-inicio">
                    <div class="card-body py-3 d-flex flex-column justify-content-center">
                        <div class="display-6 fw-bold text-success">@Model.ComensalesDesayunoHoy</div>
                        <div class="text-muted small mt-1">
                            Huéspedes para desayuno <strong>HOY</strong><br>
                            <span class="fst-italic">(@FmtFecha(Model.Hoy))</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4 d-flex">
                <div class="card text-center flex-grow-1 card-stat-inicio">
                    <div class="card-body py-3 d-flex flex-column justify-content-center">
                        <div class="display-6 fw-bold text-info">@Model.ComensalesDesayunoManana</div>
                        <div class="text-muted small mt-1">
                            Huéspedes para desayuno <strong>MAÑANA</strong><br>
                            <span class="fst-italic">(@FmtFecha(Model.Manana))</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Limpieza (ocupa el espacio restante de la columna) *@
        <div class="card flex-grow-1">
            <div class="card-header fw-semibold bg-light">
                <i class="bi bi-stars me-1"></i>Limpieza del día — @FmtFecha(Model.Hoy) <span class="text-muted fw-normal">(hoy)</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.LimpiezaDelDia.Any())
                {
                    <p class="text-muted fst-italic p-3 mb-0">Sin tareas de limpieza para hoy.</p>
                }
                else
                {
                    <table id="tabla-limpieza" class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:140px">Unidad</th>
                                <th class="ps-3">Tareas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.LimpiezaDelDia)
                            {
                                @if (item.EsGrupo)
                                {
                                    <tr>
                                        <td colspan="2" class="p-2 td-limpieza-grupo">
                                            <div class="fw-semibold mb-2">
                                                <i class="bi bi-people-fill me-1"></i>Grupo (@item.CantUnidadesOriginales unidades)
                                            </div>
                                            <div class="d-grid grid-limpieza-grupo">
                                                @foreach (var u in item.Unidades)
                                                {
                                                    @if (u.EsSubtituloApart)
                                                    {
                                                        <div style="grid-column:1/-1;" class="mt-1">
                                                            <span class="small text-muted fst-italic">@u.NombreAlojamiento</span>
                                                            @foreach (var tarea in u.Tareas)
                                                            {
                                                                <span class="badge bg-primary ms-1 mb-1 fw-bold" style="font-size:.78rem;">@tarea</span>
                                                            }
                                                        </div>
                                                    }
                                                    else if (u.EsHabDeApart)
                                                    {
                                                        <div class="align-self-start ps-3">@u.NombreAlojamiento</div>
                                                        <div>
                                                            @foreach (var tarea in u.Tareas)
                                                            {
                                                                <span class="badge bg-primary me-1 mb-1 fw-bold" style="font-size:.78rem;">@tarea</span>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="align-self-start ps-3">@u.NombreAlojamiento</div>
                                                        <div>
                                                            @foreach (var tarea in u.Tareas)
                                                            {
                                                                <span class="badge bg-primary me-1 mb-1 fw-bold" style="font-size:.78rem;">@tarea</span>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td class="fw-semibold td-nombre-individual">@item.NombreAlojamiento</td>
                                        <td class="ps-3">
                                            @foreach (var tarea in item.Tareas)
                                            {
                                                <span class="badge bg-primary me-1 mb-1 fw-bold" style="font-size:.78rem;">@tarea</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

    </div>

    @* ── Columna derecha: Estado de unidades (libres + ocupadas) ── *@
    @{
        var habOcupadas  = Model.UnidadesOcupadasHoy.Where(n => n.StartsWith("Habitación")).ToList();
        var cabOcupadas  = Model.UnidadesOcupadasHoy.Where(n => n.StartsWith("Cabaña")).ToList();
    }
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold bg-light">
                <i class="bi bi-building me-1"></i>Estado de unidades hoy
            </div>
            <div class="card-body p-0">
                <div class="row g-0 h-100">

                    @* Libres *@
                    <div class="col-6 border-end p-3">
                        <div class="fw-semibold text-success small text-uppercase mb-2" style="letter-spacing:.04em;">
                            <i class="bi bi-check-circle-fill me-1"></i>Libres
                            <span class="badge bg-success ms-1">@Model.UnidadesLibresHoy.Count</span>
                        </div>
                        @if (!Model.UnidadesLibresHoy.Any())
                        {
                            <span class="text-muted fst-italic small">Ninguna libre.</span>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 lista-unidades-estado">
                                @foreach (var nombre in habitacionesLibres)
                                {
                                    <li class="py-1 small">
                                        <i class="bi bi-check-circle text-success me-1"></i>@nombre
                                    </li>
                                }
                                @if (habitacionesLibres.Any() && cabañasLibres.Any())
                                {
                                    <li class="py-1"><hr class="my-0" /></li>
                                }
                                @foreach (var nombre in cabañasLibres)
                                {
                                    <li class="py-1 small">
                                        <i class="bi bi-check-circle text-success me-1"></i>@nombre
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @* Ocupadas *@
                    <div class="col-6 p-3">
                        <div class="fw-semibold text-danger small text-uppercase mb-2" style="letter-spacing:.04em;">
                            <i class="bi bi-x-circle-fill me-1"></i>Ocupadas
                            <span class="badge bg-danger ms-1">@Model.UnidadesOcupadasHoy.Count</span>
                        </div>
                        @if (!Model.UnidadesOcupadasHoy.Any())
                        {
                            <span class="text-muted fst-italic small">Ninguna ocupada.</span>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 lista-unidades-estado">
                                @foreach (var nombre in habOcupadas)
                                {
                                    <li class="py-1 small">
                                        <i class="bi bi-x-circle text-danger me-1"></i>@nombre
                                    </li>
                                }
                                @if (habOcupadas.Any() && cabOcupadas.Any())
                                {
                                    <li class="py-1"><hr class="my-0" /></li>
                                }
                                @foreach (var nombre in cabOcupadas)
                                {
                                    <li class="py-1 small">
                                        <i class="bi bi-x-circle text-danger me-1"></i>@nombre
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

@* ── Pendientes a cobrar en 24 hs ── *@
<div class="card mb-4">
    <div class="card-header fw-semibold bg-danger bg-opacity-10 text-danger-emphasis">
        <i class="bi bi-cash-coin me-1"></i>Pendientes a cobrar en 24 hs
        @if (Model.PendientesCobro.Any())
        {
            <span class="badge bg-danger ms-2">@Model.PendientesCobro.Count</span>
        }
    </div>
    <div class="card-body p-0">
        @if (!Model.PendientesCobro.Any())
        {
            <p class="text-muted fst-italic p-3 mb-0">Sin saldos pendientes para hoy ni mañana.</p>
        }
        else
        {
            <table class="table table-sm table-hover align-middle mb-0 tabla-pendientes">
                <thead class="table-light">
                    <tr>
                        <th>Titular</th>
                        <th class="d-mobile-none">Unidad</th>
                        <th class="text-center d-mobile-none">Check-out</th>
                        <th class="text-end">Saldo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.PendientesCobro)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @p.NombreHuesped
                                <span class="d-lg-none ms-1 @(p.EsHoy ? "aloj-badge-pendiente" : "aloj-badge-checkout-hoy")">@AbrevAloj(p.NombreAlojamiento)</span>
                            </td>
                            <td class="d-mobile-none">@p.NombreAlojamiento</td>
                            <td class="text-center d-mobile-none">
                                @if (p.FechaSalida == Model.Hoy)
                                {
                                    <span class="badge bg-danger">Hoy</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Mañana</span>
                                }
                            </td>
                            <td class="text-end fw-semibold text-danger">$@p.SaldoPendiente.ToString("N0")</td>
                            <td class="text-end">
                                <a asp-controller="Reservas" asp-action="Details" asp-route-id="@p.ReservaId"
                                   class="btn btn-outline-danger btn-sm py-0">Ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@* ══════════════════════════════════════════════════════════════
   SECCIÓN MAÑANA
   ══════════════════════════════════════════════════════════════ *@
<h5 class="text-uppercase text-muted fw-semibold mb-3" style="letter-spacing:.06em; font-size:1.1rem;">
    <i class="bi bi-calendar3 me-1" style="color:#212529;"></i><strong>Mañana</strong> — @FmtFecha(Model.Manana)
</h5>

<div class="row g-3 mb-3">
    @* Check-ins mañana *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold bg-success bg-opacity-10 text-success-emphasis">
                <i class="bi bi-box-arrow-in-right me-1"></i>Check-ins de <strong>MAÑANA</strong>
                <span class="badge bg-success ms-2">@Model.CheckInsManana.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.CheckInsManana.Any())
                {
                    <p class="text-muted fst-italic p-3 mb-0">Sin check-ins para mañana.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush lista-ver-items">
                        @foreach (var item in Model.CheckInsManana)
                        {
                            @if (item.EsGrupal)
                            {
                                <li class="list-group-item d-flex align-items-start gap-2 py-2">
                                    <span class="fw-semibold flex-shrink-0">@item.NombreHuesped</span>
                                    <span class="d-flex flex-column gap-1 flex-fill ps-3">
                                        @foreach (var u in item.NombresUnidadesGrupales)
                                        {
                                            <span class="aloj-badge-checkin" style="width:fit-content;">@u</span>
                                        }
                                    </span>
                                    <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.ReservaId"
                                       class="btn btn-outline-secondary btn-sm py-0 flex-shrink-0">Ver</a>
                                </li>
                            }
                            else
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                    <span>
                                        <span class="fw-semibold">@item.NombreHuesped</span>
                                        <span class="ms-1 aloj-badge-checkin">@item.NombreAlojamiento</span>
                                    </span>
                                    <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.ReservaId"
                                       class="btn btn-outline-secondary btn-sm py-0">Ver</a>
                                </li>
                            }
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    @* Check-outs mañana *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold bg-warning bg-opacity-10 text-warning-emphasis">
                <i class="bi bi-box-arrow-right me-1"></i>Check-outs de <strong>MAÑANA</strong>
                <span class="badge bg-warning text-dark ms-2">@Model.CheckOutsManana.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.CheckOutsManana.Any())
                {
                    <p class="text-muted fst-italic p-3 mb-0">Sin check-outs para mañana.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush lista-ver-items">
                        @foreach (var item in Model.CheckOutsManana)
                        {
                            @if (item.EsGrupal)
                            {
                                <li class="list-group-item d-flex align-items-start gap-2 py-2">
                                    <span class="fw-semibold flex-shrink-0">@item.NombreHuesped</span>
                                    <span class="d-flex flex-column gap-1 flex-fill ps-3">
                                        @foreach (var u in item.NombresUnidadesGrupales)
                                        {
                                            <span class="aloj-badge-manana" style="width:fit-content;">@u</span>
                                        }
                                    </span>
                                    <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.ReservaId"
                                       class="btn btn-outline-secondary btn-sm py-0 flex-shrink-0">Ver</a>
                                </li>
                            }
                            else
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                    <span>
                                        <span class="fw-semibold">@item.NombreHuesped</span>
                                        <span class="ms-1 aloj-badge-manana">@item.NombreAlojamiento</span>
                                    </span>
                                    <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.ReservaId"
                                       class="btn btn-outline-secondary btn-sm py-0">Ver</a>
                                </li>
                            }
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
