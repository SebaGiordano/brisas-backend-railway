</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
    // ── Constantes y estado ──────────────────────────────────────────────────
    const PREV_ALOJ_ID = '@prevAlojId';
    let capacidades    = {};   // { "id": capacidad } de alojamientos disponibles
    let totalFijo      = false;
    let esGrupal       = false;

    // Estado grupal: { id -> { nombre, capacidad, personas } }
    let unidadesGrupales = {};

    // ── Helpers ──────────────────────────────────────────────────────────────
    function gid(id) { return document.getElementById(id); }

    // ── Dropdown personalizado de Alojamiento (siempre abre hacia abajo) ─────
    function sincronizarBotonAlojamiento() {
        const select = gid('AlojamientoId');
        const btn    = gid('AlojamientoId-btn');
        const opt    = select.options[select.selectedIndex];
        btn.textContent = opt ? opt.textContent : '— Seleccioná un alojamiento —';
        btn.disabled = select.disabled;
        if (select.disabled) cerrarMenuAlojamiento();
    }

    function poblarMenuAlojamiento() {
        const select = gid('AlojamientoId');
        const menu   = gid('AlojamientoId-menu');
        menu.innerHTML = '';
        Array.from(select.options).forEach(opt => {
            const item = document.createElement('div');
            item.className = 'custom-select-item' + (opt.value === select.value ? ' active' : '')
                            + (opt.value === '' ? ' placeholder' : '');
            item.textContent = opt.textContent;
            item.addEventListener('click', function () {
                select.value = opt.value;
                select.dispatchEvent(new Event('change'));
                sincronizarBotonAlojamiento();
                cerrarMenuAlojamiento();
            });
            menu.appendChild(item);
        });
    }

    function abrirMenuAlojamiento() {
        if (gid('AlojamientoId-btn').disabled) return;
        poblarMenuAlojamiento();
        gid('AlojamientoId-menu').classList.remove('d-none');
    }

    function cerrarMenuAlojamiento() {
        gid('AlojamientoId-menu').classList.add('d-none');
    }

    gid('AlojamientoId-btn').addEventListener('click', function (e) {
        e.stopPropagation();
        if (gid('AlojamientoId-menu').classList.contains('d-none')) abrirMenuAlojamiento();
        else cerrarMenuAlojamiento();
    });

    document.addEventListener('click', function (e) {
        if (!e.target.closest('#AlojamientoId-wrapper')) cerrarMenuAlojamiento();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') cerrarMenuAlojamiento();
    });

    function getCapacidad() {
        const id = gid('AlojamientoId').value;
        return id ? (capacidades[id] ?? null) : null;
    }

    function calcularNoches() {
        const ingreso = gid('FechaIngreso').value;
        const egreso  = gid('FechaSalida').value;
        if (!ingreso || !egreso) return null;
        const diff = Math.round(
            (new Date(egreso + 'T00:00:00') - new Date(ingreso + 'T00:00:00')) / 86400000
        );
        return diff > 0 ? diff : null;
    }

    // ── Aire acondicionado: estado y helpers ─────────────────────────────────
    let aireCabanasSeleccionadas = {}; // { alojamientoId: Set<'YYYY-MM-DD'> }

    function obtenerCabanasParaAire() {
        if (esGrupal) {
            return Object.entries(unidadesGrupales)
                .filter(([id, u]) => u.tipo === 'Cabaña')
                .map(([id, u]) => ({ id: parseInt(id), nombre: u.nombre }));
        }
        const alojId = gid('AlojamientoId').value;
        if (!alojId) return [];
        const datos = _datosDisponibles.find(a => String(a.id) === String(alojId));
        if (!datos || datos.tipo !== 'Cabaña') return [];
        return [{ id: datos.id, nombre: datos.nombre }];
    }

    function generarNochesEstadia() {
        const ingreso = gid('FechaIngreso').value;
        const egreso  = gid('FechaSalida').value;
        if (!ingreso || !egreso) return [];
        const noches = [];
        let d = new Date(ingreso + 'T00:00:00');
        const fin = new Date(egreso + 'T00:00:00');
        while (d < fin) {
            noches.push(d.toISOString().slice(0, 10));
            d.setDate(d.getDate() + 1);
        }
        return noches;
    }

    function calcularSubtotalAire() {
        if (!gid('UsaAireAcondicionado').checked) return 0;
        const precio = parseFloat(gid('PrecioAireDiario').value) || 0;
        if (precio <= 0) return 0;
        let totalDias = 0;
        Object.values(aireCabanasSeleccionadas).forEach(set => { totalDias += set.size; });
        return totalDias * precio;
    }

    function fmtMonedaAire(n) {
        return '$' + Math.round(n).toLocaleString('es-AR');
    }

    function actualizarTotalFinalUI() {
        const subtotalAire = calcularSubtotalAire();
        const montoAlojamiento = parseFloat(gid('MontoTotal').value) || 0;

        let totalDias = 0;
        Object.values(aireCabanasSeleccionadas).forEach(s => { totalDias += s.size; });

        gid('desglose-dias-aire').textContent = totalDias;
        gid('desglose-monto-aire').textContent = fmtMonedaAire(subtotalAire);
        gid('desglose-total-final').textContent = fmtMonedaAire(montoAlojamiento + subtotalAire);
    }

    function actualizarResumenAireTexto() {
        const cabanas = obtenerCabanasParaAire();
        const precio  = parseFloat(gid('PrecioAireDiario').value) || 0;
        const resumenEl = gid('resumen-aire');

        if (cabanas.length === 0) { resumenEl.innerHTML = ''; return; }

        let totalDias = 0;
        const lineas = cabanas.map(cab => {
            const dias = aireCabanasSeleccionadas[cab.id]?.size || 0;
            totalDias += dias;
            const subtotalCabana = dias * precio;
            return `<div style="font-weight:500;">${cab.nombre}: ${dias} día${dias !== 1 ? 's' : ''} × $${precio.toLocaleString('es-AR')} = $${subtotalCabana.toLocaleString('es-AR')}</div>`;
        });

        const totalGeneral = totalDias * precio;
        resumenEl.innerHTML = lineas.join('') +
            `<div class="fw-bold mt-2 pt-1" style="border-top:1px solid #dee2e6; font-size:.92rem;">Total aire: $${totalGeneral.toLocaleString('es-AR')}</div>`;
    }

    function renderCalendariosAire() {
        const cabanas    = obtenerCabanasParaAire();
        const alerta     = gid('alerta-aire-sin-cabanas');
        const contenido  = gid('contenido-aire');
        const cont       = gid('calendarios-aire-por-cabana');

        if (!gid('UsaAireAcondicionado').checked) return;

        if (cabanas.length === 0) {
            alerta.classList.remove('d-none');
            contenido.classList.add('d-none');
            aireCabanasSeleccionadas = {};
            actualizarTotalFinalUI();
            return;
        }

        alerta.classList.add('d-none');
        contenido.classList.remove('d-none');

        const noches = generarNochesEstadia();
        const idsCabanasActuales = new Set(cabanas.map(c => String(c.id)));

        // Descartar selecciones de cabañas que ya no forman parte de la reserva
        Object.keys(aireCabanasSeleccionadas).forEach(id => {
            if (!idsCabanasActuales.has(String(id))) delete aireCabanasSeleccionadas[id];
        });
        // Descartar días que quedaron fuera del nuevo rango de noches (edición de fechas)
        const setNoches = new Set(noches);
        Object.keys(aireCabanasSeleccionadas).forEach(id => {
            aireCabanasSeleccionadas[id] = new Set(
                [...aireCabanasSeleccionadas[id]].filter(f => setNoches.has(f))
            );
        });

        cont.innerHTML = '';
        if (noches.length === 0) {
            cont.innerHTML = '<p class="text-muted small mb-0">Seleccioná las fechas de ingreso y egreso primero.</p>';
            actualizarTotalFinalUI();
            return;
        }

        cabanas.forEach(cab => {
            if (!aireCabanasSeleccionadas[cab.id]) aireCabanasSeleccionadas[cab.id] = new Set();
            const seleccionadas = aireCabanasSeleccionadas[cab.id];

            const wrap = document.createElement('div');
            wrap.className = 'mb-3 pb-2 border-bottom';
            wrap.innerHTML = `<div class="fw-semibold small mb-2"><i class="bi bi-snow2 me-1"></i>${cab.nombre}</div>`;

            const grid = document.createElement('div');
            grid.className = 'd-flex flex-wrap gap-2';

            noches.forEach(fechaIso => {
                const id = `aire-${cab.id}-${fechaIso}`;
                const [y, m, d] = fechaIso.split('-');
                const wrapperChk = document.createElement('div');
                wrapperChk.innerHTML = `
                    <input type="checkbox" class="btn-check chk-aire-dia" id="${id}"
                           data-cabana-id="${cab.id}" data-fecha="${fechaIso}"
                           ${seleccionadas.has(fechaIso) ? 'checked' : ''}>
                    <label class="btn btn-outline-primary btn-sm" for="${id}">${d}/${m}</label>
                `;
                grid.appendChild(wrapperChk.firstElementChild);
                grid.appendChild(wrapperChk.firstElementChild);
            });

            wrap.appendChild(grid);
            cont.appendChild(wrap);
        });

        cont.querySelectorAll('.chk-aire-dia').forEach(chk => {
            chk.addEventListener('change', function () {
                const cabId = this.dataset.cabanaId;
                const fecha = this.dataset.fecha;
                if (!aireCabanasSeleccionadas[cabId]) aireCabanasSeleccionadas[cabId] = new Set();
                if (this.checked) aireCabanasSeleccionadas[cabId].add(fecha);
                else aireCabanasSeleccionadas[cabId].delete(fecha);
                actualizarResumenAireTexto();
                actualizarTotalFinalUI();
            });
        });

        actualizarResumenAireTexto();
        actualizarTotalFinalUI();
    }

    function prepararCamposAire() {
        let cont = gid('container-aire-cabanas');
        if (!cont) {
            cont = document.createElement('div');
            cont.id = 'container-aire-cabanas';
            gid('form-reserva').appendChild(cont);
        }
        cont.innerHTML = '';
        if (!gid('UsaAireAcondicionado').checked) return;

        let i = 0;
        Object.entries(aireCabanasSeleccionadas).forEach(([cabId, fechasSet]) => {
            if (fechasSet.size === 0) return;
            const mk = (name, value) => {
                const inp = document.createElement('input');
                inp.type = 'hidden'; inp.name = name; inp.value = value;
                cont.appendChild(inp);
            };
            mk(`AireCabanas[${i}].AlojamientoId`, cabId);
            [...fechasSet].forEach((f, j) => mk(`AireCabanas[${i}].Fechas[${j}]`, f));
            i++;
        });
    }

    // ── Reservas vinculadas ───────────────────────────────────────────────────
    let reservasVinculadas = {}; // { id: { id, nombreHuesped, esGrupal, cantUnidades, nombreAlojamiento } }
    let vinculoAEliminar   = false;

    function renderListaVinculadas() {
        const cont = gid('lista-vinculadas');
        const ids  = Object.keys(reservasVinculadas);
        if (ids.length === 0) {
            cont.innerHTML = '<p class="text-muted small mb-0">Todavía no vinculaste ninguna reserva.</p>';
            return;
        }
        cont.innerHTML = ids.map(id => {
            const r = reservasVinculadas[id];
            const tipoTxt = r.esGrupal ? `Grupo (${r.cantUnidades} unidades)` : r.nombreAlojamiento;
            return `
                <div class="vinculada-item" data-id="${id}">
                    <div class="vinculada-info">
                        <strong>${r.nombreHuesped}</strong>
                        <span class="text-muted"> — ${tipoTxt}</span>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm quitar-vinculada" data-id="${id}">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>`;
        }).join('');

        cont.querySelectorAll('.quitar-vinculada').forEach(btn => {
            btn.addEventListener('click', function () {
                delete reservasVinculadas[this.dataset.id];
                renderListaVinculadas();
            });
        });
    }

    function inicializarBuscadorVinculo() {
        const input = gid('buscar-reserva-vincular');
        if (!input || input.dataset.inicializado) return;
        input.dataset.inicializado = 'true';

        const wrapper = document.createElement('div');
        wrapper.style.position = 'relative';
        input.parentNode.insertBefore(wrapper, input);
        wrapper.appendChild(input);

        const dropdown = document.createElement('ul');
        dropdown.className = 'vinculo-ac-dropdown';
        wrapper.appendChild(dropdown);

        let debounceVinculo;
        const excludeId = typeof RESERVA_ID !== 'undefined' ? RESERVA_ID : '';

        input.addEventListener('input', () => {
            clearTimeout(debounceVinculo);
            const q = input.value.trim();
            if (q.length < 1) { dropdown.style.display = 'none'; return; }
            debounceVinculo = setTimeout(async () => {
                try {
                    const url = `/Reservas/BuscarReservasParaVincular?q=${encodeURIComponent(q)}${excludeId ? '&excludeId=' + excludeId : ''}`;
                    const res = await fetch(url);
                    const items = await res.json();
                    renderDropdownVinculo(items);
                } catch { dropdown.style.display = 'none'; }
            }, 220);
        });

        function renderDropdownVinculo(items) {
            dropdown.innerHTML = '';
            const disponibles = items.filter(it => !reservasVinculadas[it.id]);
            if (!disponibles.length) { dropdown.style.display = 'none'; return; }
            disponibles.forEach(item => {
                const li = document.createElement('li');
                const tipoTxt = item.esGrupal ? `Grupo (${item.cantUnidades} unidades)` : `${item.nombreAlojamiento} (individual)`;
                li.innerHTML = `${item.nombreHuesped}<span class="vinculo-tipo-badge">${tipoTxt} — ${item.fechaIngreso} al ${item.fechaSalida}</span>`;
                li.addEventListener('mousedown', e => {
                    e.preventDefault();
                    reservasVinculadas[item.id] = item;
                    renderListaVinculadas();
                    input.value = '';
                    dropdown.style.display = 'none';
                });
                dropdown.appendChild(li);
            });
            dropdown.style.display = 'block';
        }

        document.addEventListener('click', e => {
            if (!wrapper.contains(e.target)) dropdown.style.display = 'none';
        });
    }

    function prepararCamposVinculo() {
        let cont = gid('container-vinculo');
        cont.innerHTML = '';

        if (!gid('UsarVinculo').checked) {
            if (typeof RESERVA_ID !== 'undefined') {
                const mk = document.createElement('input');
                mk.type = 'hidden'; mk.name = 'EliminarVinculo'; mk.value = 'true';
                cont.appendChild(mk);
            }
            return;
        }

        Object.keys(reservasVinculadas).forEach((id, i) => {
            const mk = document.createElement('input');
            mk.type = 'hidden'; mk.name = `ReservasVinculadasIds[${i}]`; mk.value = id;
            cont.appendChild(mk);
        });
    }

    gid('UsarVinculo')?.addEventListener('change', function () {
        gid('seccion-vinculo').classList.toggle('d-none', !this.checked);
        if (this.checked) inicializarBuscadorVinculo();
    });

    function habilitarCampo(id) {
        const el = gid(id);
        el.readOnly = false;
        el.classList.remove('campo-inactivo');
    }

    function bloquearCampo(id) {
        const el = gid(id);
        el.readOnly = true;
        el.classList.add('campo-inactivo');
    }

    // ── Modo grupal: toggle ───────────────────────────────────────────────────
    function actualizarAlertaGrupal() {
        const ingreso = gid('FechaIngreso').value;
        const egreso  = gid('FechaSalida').value;
        const alerta  = gid('alerta-grupal-info');
        if (!ingreso || !egreso) {
            alerta.className = 'alert alert-warning py-2 px-3 mb-3 small';
            alerta.innerHTML = '<i class="bi bi-calendar-x me-1"></i>' +
                'Seleccioná primero las fechas de ingreso y egreso para poder elegir las unidades de la reserva grupal.';
        } else {
            alerta.className = 'alert alert-info py-2 px-3 mb-3 small';
            alerta.innerHTML = '<i class="bi bi-info-circle me-1"></i>' +
                'Tildá todas las unidades que van a formar parte de esta reserva grupal.';
        }
    }

    function toggleModoGrupal(activar) {
        esGrupal = activar;
        gid('seccion-individual').classList.toggle('d-none', activar);
        gid('seccion-grupal').classList.toggle('d-none', !activar);

        if (activar) {
            actualizarAlertaGrupal();
            // En modo grupal: precio por día queda bloqueado hasta tener fechas + unidades tildadas
            totalFijo = false;
            gid('MontoTotal').value = '';
            gid('total-hint').textContent = 'Se calcula automáticamente (precio × noches)';
            actualizarPrecioState();
            // Renderizar checkboxes si ya hay disponibles cargados (con su "tipo" original)
            if (_datosDisponibles.length > 0)
                renderCheckboxesGrupales(_datosDisponibles);
        } else {
            // Reset completo a modo individual limpio
            unidadesGrupales = {};
            gid('container-unidades-grupales').innerHTML = '';
            actualizarResumenGrupal();

            gid('AlojamientoId').value = '';
            sincronizarBotonAlojamiento();
            gid('CantidadHuespedes').disabled = true;
            gid('CantidadHuespedes').value    = '';
            gid('capacidad-hint').textContent = 'Seleccioná un alojamiento primero';

            totalFijo = false;
            gid('PrecioPorDia').value = '';
            gid('MontoTotal').value   = '';
            gid('total-hint').textContent = 'Se calcula automáticamente (precio × noches)';
            actualizarPrecioState();
            actualizarNochesYTotal();
        }
        renderCalendariosAire();
    }

    // Mapa auxiliar id → nombre para reconstruir checkboxes al togglear
    let _nombresDisponibles = {};
    let _datosDisponibles   = [];

    // ── Modo grupal: renderizar checkboxes ────────────────────────────────────
    function crearItemCheckboxGrupal(a) {
        const checked  = unidadesGrupales[a.id] ? 'checked' : '';
        const personas = unidadesGrupales[a.id]?.personas ?? 0;
        const etiqueta = personas > 0
            ? `<span class="badge bg-primary ms-2" id="badge-${a.id}">${personas} persona${personas !== 1 ? 's' : ''}</span>`
            : `<span class="badge bg-secondary ms-2 d-none" id="badge-${a.id}"></span>`;

        const div = document.createElement('div');
        div.className = 'grupal-item d-flex align-items-center gap-2 py-2';
        div.innerHTML = `
            <div class="form-check mb-0 flex-grow-1">
                <input class="form-check-input chk-aloj" type="checkbox"
                       id="chk-aloj-${a.id}"
                       data-id="${a.id}" data-nombre="${a.nombre}" data-cap="${a.capacidad}" data-tipo="${a.tipo}"
                       ${checked}>
                <label class="form-check-label" for="chk-aloj-${a.id}">
                    ${a.nombre}
                    <span class="text-muted small ms-1">(cap. ${a.capacidad})</span>
                </label>
                ${etiqueta}
            </div>`;
        return div;
    }

    function renderCheckboxesGrupales(data) {
        _datosDisponibles = data;
        const lista = gid('lista-checkboxes-grupal');
        if (!data || data.length === 0) {
            lista.innerHTML = '<p class="text-muted small">No hay unidades disponibles para las fechas seleccionadas.</p>';
            return;
        }
        lista.innerHTML = '';

        // Columna izquierda: Habitaciones + Aparts. Columna derecha: Cabañas.
        // (mismo criterio de orden que el resto del sistema: Habitacion, Apart, Cabaña)
        const izquierda = data.filter(a => a.tipo !== 'Cabaña');
        const derecha   = data.filter(a => a.tipo === 'Cabaña');

        const grid = document.createElement('div');
        grid.className = 'grid-checkboxes-grupal';

        const colIzq = document.createElement('div');
        colIzq.className = 'columna-grupal';
        if (izquierda.length > 0) {
            const titIzq = document.createElement('div');
            titIzq.className = 'columna-grupal-titulo';
            titIzq.textContent = 'Habitaciones y Aparts';
            colIzq.appendChild(titIzq);
            izquierda.forEach(a => colIzq.appendChild(crearItemCheckboxGrupal(a)));
        }

        const colDer = document.createElement('div');
        colDer.className = 'columna-grupal';
        if (derecha.length > 0) {
            const titDer = document.createElement('div');
            titDer.className = 'columna-grupal-titulo';
            titDer.textContent = 'Cabañas';
            colDer.appendChild(titDer);
            derecha.forEach(a => colDer.appendChild(crearItemCheckboxGrupal(a)));
        }

        if (izquierda.length > 0) grid.appendChild(colIzq);
        if (derecha.length   > 0) grid.appendChild(colDer);
        lista.appendChild(grid);

        // Listeners en checkboxes
        lista.querySelectorAll('.chk-aloj').forEach(chk => {
            chk.addEventListener('change', function () {
                if (this.checked) {
                    abrirModalPersonas(
                        parseInt(this.dataset.id),
                        this.dataset.nombre,
                        parseInt(this.dataset.cap),
                        this.dataset.tipo
                    );
                } else {
                    delete unidadesGrupales[parseInt(this.dataset.id)];
                    const badge = gid(`badge-${this.dataset.id}`);
                    if (badge) { badge.textContent = ''; badge.classList.add('d-none'); }
                    actualizarResumenGrupal();
                    renderCalendariosAire();
                }
            });
        });

        gid('disponibilidad-msg-grupal').className = 'form-text text-success mb-2';
        const cantUnidades = data.filter(a => !a.nombre.startsWith('Apart')).length;
        gid('disponibilidad-msg-grupal').textContent = `${cantUnidades} de 16 unidades disponibles.`;
        renderCalendariosAire();
    }

    // ── Modal personas por unidad ─────────────────────────────────────────────
    let _modalPersonasAlojId   = null;
    let _modalPersonasAlojNombre = '';
    let _modalPersonasCap      = 0;
    let _modalPersonasTipo     = '';

    function abrirModalPersonas(alojId, nombre, cap, tipo) {
        _modalPersonasAlojId     = alojId;
        _modalPersonasAlojNombre = nombre;
        _modalPersonasCap        = cap;
        _modalPersonasTipo       = tipo;

        gid('modal-personas-titulo').textContent  = `Personas en ${nombre}`;
        gid('modal-personas-capacidad').textContent = `Capacidad máxima: ${cap} personas`;
        gid('input-personas-modal').max   = cap;
        gid('input-personas-modal').value = unidadesGrupales[alojId]?.personas ?? '';
        gid('modal-personas-error').classList.add('d-none');

        bootstrap.Modal.getOrCreateInstance(gid('modal-personas-unidad')).show();
        setTimeout(() => gid('input-personas-modal').focus(), 300);
    }

    function cerrarModalPersonasSinConfirmar() {
        // Si el checkbox no tenía valor previo, desmarcarlo
        if (_modalPersonasAlojId !== null && !unidadesGrupales[_modalPersonasAlojId]) {
            const chk = gid(`chk-aloj-${_modalPersonasAlojId}`);
            if (chk) chk.checked = false;
        }
        bootstrap.Modal.getInstance(gid('modal-personas-unidad'))?.hide();
    }

    gid('btn-cerrar-modal-personas').addEventListener('click', cerrarModalPersonasSinConfirmar);
    gid('btn-cancelar-personas').addEventListener('click',     cerrarModalPersonasSinConfirmar);

    gid('btn-confirmar-personas').addEventListener('click', function () {
        const val = parseInt(gid('input-personas-modal').value);
        const errEl = gid('modal-personas-error');

        if (!val || val < 1) {
            errEl.textContent = 'Ingresá al menos 1 persona.';
            errEl.classList.remove('d-none');
            return;
        }
        if (val > _modalPersonasCap) {
            errEl.textContent = `Supera la capacidad máxima de ${_modalPersonasCap} personas.`;
            errEl.classList.remove('d-none');
            return;
        }

        unidadesGrupales[_modalPersonasAlojId] = {
            nombre: _modalPersonasAlojNombre,
            capacidad: _modalPersonasCap,
            personas: val,
            tipo: _modalPersonasTipo
        };

        const badge = gid(`badge-${_modalPersonasAlojId}`);
        if (badge) {
            badge.textContent = `${val} persona${val !== 1 ? 's' : ''}`;
            badge.classList.remove('d-none');
        }

        bootstrap.Modal.getInstance(gid('modal-personas-unidad'))?.hide();
        actualizarResumenGrupal();
        renderCalendariosAire();
    });

    // Confirmar con Enter
    gid('input-personas-modal').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); gid('btn-confirmar-personas').click(); }
    });

    function actualizarResumenGrupal() {
        const ids = Object.keys(unidadesGrupales);
        const cantUnidades = ids.length;
        const totalPersonas = ids.reduce((s, id) => s + (unidadesGrupales[id]?.personas ?? 0), 0);

        gid('grupal-cant-unidades').textContent  = cantUnidades;
        gid('grupal-total-personas').textContent = totalPersonas;
        gid('resumen-grupal').classList.toggle('d-none', cantUnidades === 0);

        actualizarPrecioState();
    }

    // ── Disponibilidad (AJAX) ────────────────────────────────────────────────
    async function buscarDisponibles() {
        const ingreso = gid('FechaIngreso').value;
        const egreso  = gid('FechaSalida').value;
        if (!ingreso || !egreso) return;

        const select = gid('AlojamientoId');
        const msg    = gid('disponibilidad-msg');

        select.disabled  = true;
        select.innerHTML = '<option value="">Verificando disponibilidad…</option>';
        msg.className    = 'form-text text-muted';
        msg.textContent  = '';
        sincronizarBotonAlojamiento();

        if (esGrupal) {
            actualizarAlertaGrupal();
            gid('lista-checkboxes-grupal').innerHTML =
                '<p class="text-muted small">Verificando disponibilidad…</p>';
            gid('disponibilidad-msg-grupal').textContent = '';
        }

        resetDownstreamDeAlojamiento();

        try {
            const resp = await fetch(
                `/Reservas/AlojamientosDisponibles?fechaIngreso=${ingreso}&fechaEgreso=${egreso}`
            );
            const data = await resp.json();

            select.innerHTML = '';
            if (data.length === 0) {
                select.innerHTML = '<option value="">— Sin disponibilidad —</option>';
                msg.className    = 'form-text text-danger fw-semibold';
                msg.textContent  = 'No hay alojamientos disponibles para las fechas seleccionadas.';
                _datosDisponibles = [];
                sincronizarBotonAlojamiento();
                if (esGrupal) {
                    gid('lista-checkboxes-grupal').innerHTML =
                        '<p class="text-muted small text-danger">Sin unidades disponibles para esas fechas.</p>';
                }
            } else {
                const opt0 = document.createElement('option');
                opt0.value       = '';
                opt0.textContent = '— Seleccioná un alojamiento —';
                select.appendChild(opt0);

                data.forEach(a => {
                    const opt = document.createElement('option');
                    opt.value       = a.id;
                    opt.textContent = a.nombre;
                    select.appendChild(opt);
                });

                capacidades = Object.fromEntries(data.map(a => [String(a.id), a.capacidad]));
                _nombresDisponibles = Object.fromEntries(data.map(a => [String(a.id), a.nombre]));
                _datosDisponibles = data;
                select.disabled = false;

                const cantUnidades = data.filter(a => !a.nombre.startsWith('Apart')).length;
                msg.className   = 'form-text text-success';
                msg.textContent = `${cantUnidades} de 16 unidades disponibles.`;

                if (esGrupal) {
                    // Limpiar selecciones que ya no están disponibles
                    Object.keys(unidadesGrupales).forEach(id => {
                        if (!capacidades[id]) delete unidadesGrupales[id];
                    });
                    renderCheckboxesGrupales(data);
                } else {
                    // Restaurar selección tras postback
                    if (PREV_ALOJ_ID && select.querySelector(`option[value="${PREV_ALOJ_ID}"]`)) {
                        select.value = PREV_ALOJ_ID;
                        actualizarCantidadState();
                        actualizarPrecioState();
                    }
                }
                sincronizarBotonAlojamiento();
            }
        } catch {
            select.innerHTML = '<option value="">— Error al verificar —</option>';
            select.disabled  = false;
            msg.className    = 'form-text text-danger';
            msg.textContent  = 'Error al verificar disponibilidad. Intentá de nuevo.';
            sincronizarBotonAlojamiento();
        }
    }

    function resetDownstreamDeAlojamiento() {
        const cantidad = gid('CantidadHuespedes');
        cantidad.disabled = true;
        cantidad.value    = '';
        gid('capacidad-hint').textContent = 'Seleccioná un alojamiento primero';

        bloquearCampo('PrecioPorDia');
        bloquearCampo('MontoTotal');
        gid('PrecioPorDia').value = '';
        gid('MontoTotal').value   = '';
        gid('total-hint').textContent = 'Se calcula automáticamente (precio × noches)';
        totalFijo = false;

        if (esGrupal) {
            unidadesGrupales = {};
            actualizarResumenGrupal(); // re-evalúa Precio/Total según fechas + unidades
        }
    }

    // ── Invitación ────────────────────────────────────────────────────────────
    function aplicarModoInvitacion(esInvitacion) {
        if (esInvitacion) {
            bloquearCampo('PrecioPorDia');
            gid('PrecioPorDia').value = '0';
            gid('precio-hint').textContent = 'Invitación — sin costo';
            habilitarCampo('MontoTotal');
            if (!gid('MontoTotal').value) gid('MontoTotal').value = '0';
            totalFijo = true;
            gid('total-hint').textContent = 'Podés registrar una colaboración voluntaria si aplica';
        } else {
            totalFijo = false;
            gid('MontoTotal').value = '';
            gid('total-hint').textContent = 'Se calcula automáticamente (precio × noches)';
            actualizarPrecioState();
            actualizarNochesYTotal();
        }
    }

    // ── Cantidad de huéspedes ─────────────────────────────────────────────────
    function actualizarCantidadState() {
        const cap   = getCapacidad();
        const input = gid('CantidadHuespedes');
        const hint  = gid('capacidad-hint');
        if (cap) {
            input.disabled   = false;
            input.max        = cap;
            hint.textContent = `Capacidad máxima: ${cap} personas`;
            if (parseInt(input.value) > cap) input.value = cap;
        } else {
            input.disabled   = true;
            input.value      = '';
            hint.textContent = 'Seleccioná un alojamiento primero';
        }
    }

    // ── Estado del precio ─────────────────────────────────────────────────────
    function actualizarPrecioState() {
        if (gid('EsInvitacion').checked) return;
        if (esGrupal) {
            const fechasOk   = !!gid('FechaIngreso').value && !!gid('FechaSalida').value;
            const unidadesOk = Object.keys(unidadesGrupales).length > 0;

            if (fechasOk && unidadesOk) {
                habilitarCampo('PrecioPorDia');
                habilitarCampo('MontoTotal');
                gid('precio-hint').textContent = 'Sin sugerencia de tarifa — ingresá el precio por día manualmente';
            } else {
                bloquearCampo('PrecioPorDia');
                gid('PrecioPorDia').value = '';
                gid('precio-hint').textContent = !fechasOk
                    ? 'Completá las fechas de ingreso y egreso para habilitar'
                    : 'Tildá al menos una unidad con personas asignadas para habilitar';
                bloquearCampo('MontoTotal');
                gid('MontoTotal').value = '';
                gid('total-hint').textContent = 'Se calcula automáticamente (precio × noches)';
                totalFijo = false;
            }
            return;
        }
        const alojOk     = !!gid('AlojamientoId').value;
        const personasOk = parseInt(gid('CantidadHuespedes').value) > 0;

        if (alojOk && personasOk) {
            habilitarCampo('PrecioPorDia');
            habilitarCampo('MontoTotal');
            gid('precio-hint').textContent = 'Ingresá el precio o aplicá un descuento sobre la tarifa';
        } else {
            bloquearCampo('PrecioPorDia');
            gid('PrecioPorDia').value = '';
            gid('precio-hint').textContent = 'Completá alojamiento y personas para habilitar';
            bloquearCampo('MontoTotal');
            gid('MontoTotal').value     = '';
            gid('noches-display').value = '';
            gid('total-hint').textContent = 'Se calcula automáticamente (precio × noches)';
            totalFijo = false;
        }
    }

    // ── Noches y total ────────────────────────────────────────────────────────
    function actualizarNochesYTotal() {
        if (gid('EsInvitacion').checked) return;
        const noches = calcularNoches();
        gid('noches-display').value = noches != null
            ? `${noches} noche${noches !== 1 ? 's' : ''}` : '';

        if (totalFijo) {
            const total = parseFloat(gid('MontoTotal').value);
            if (noches != null && noches > 0 && total > 0) {
                gid('PrecioPorDia').value = (total / noches).toFixed(2);
                gid('precio-hint').textContent = 'Calculado automáticamente (total ÷ noches)';
            }
        } else {
            const precio = parseFloat(gid('PrecioPorDia').value);
            if (noches != null && precio > 0) {
                gid('MontoTotal').value = (precio * noches).toFixed(2);
                gid('total-hint').textContent = 'Se calcula automáticamente (precio × noches)';
            } else {
                gid('MontoTotal').value = '';
            }
        }
        actualizarTotalFinalUI();
    }

    // ── Precio sugerido por temporada (AJAX) ─────────────────────────────────
    let _debPrecio;
    async function consultarPrecioSugerido() {
        if (gid('EsInvitacion').checked || esGrupal) return;
        const alojId   = gid('AlojamientoId').value;
        const personas = parseInt(gid('CantidadHuespedes').value);
        if (!alojId || !personas || personas < 1) return;

        const fecha = gid('FechaIngreso').value ?? '';
        try {
            const res  = await fetch(
                `/Reservas/ObtenerPrecioSugerido?alojamientoId=${alojId}&personas=${personas}&fechaIngreso=${fecha}`
            );
            const data = await res.json();
            const incluyeDesayuno = gid('IncluyeDesayuno').checked;
            const precio = incluyeDesayuno ? data.precioConDesayuno : data.precioSinDesayuno;
            if (precio != null && precio > 0) {
                habilitarCampo('PrecioPorDia');
                gid('PrecioPorDia').value = precio;
                const tempLabel = data.temporada ? ` — ${data.temporada}` : '';
                gid('precio-hint').textContent = `Tarifa configurada: $${precio}/día${tempLabel}`;
                totalFijo = false;
                actualizarNochesYTotal();
            } else {
                gid('PrecioPorDia').value = '';
                gid('precio-hint').textContent = 'Sin tarifa configurada — ingresá el precio manualmente';
                totalFijo = false;
                actualizarNochesYTotal();
            }
        } catch { /* silencioso */ }
    }

    // ── Event listeners ───────────────────────────────────────────────────────

    gid('EsGrupal').addEventListener('change', function () {
        toggleModoGrupal(this.checked);
    });

    gid('EsInvitacion').addEventListener('change', function () {
        aplicarModoInvitacion(this.checked);
    });

    gid('UsaAireAcondicionado').addEventListener('change', function () {
        gid('seccion-aire').classList.toggle('d-none', !this.checked);
        if (this.checked) {
            renderCalendariosAire();
        } else {
            aireCabanasSeleccionadas = {};
            actualizarTotalFinalUI();
        }
    });

    gid('PrecioAireDiario').addEventListener('input', function () {
        actualizarResumenAireTexto();
        actualizarTotalFinalUI();
    });

    gid('FechaIngreso').addEventListener('change', function () {
        const egresoInput = gid('FechaSalida');
        if (this.value) {
            const minDate = new Date(this.value + 'T00:00:00');
            minDate.setDate(minDate.getDate() + 1);
            egresoInput.min = minDate.toISOString().split('T')[0];
            if (egresoInput.value && egresoInput.value <= this.value)
                egresoInput.value = '';
            egresoInput.disabled = false;
            gid('egreso-hint').textContent = '';
        } else {
            egresoInput.disabled = true;
            egresoInput.value    = '';
            gid('egreso-hint').textContent = 'Seleccioná la fecha de ingreso primero';
        }
        const select = gid('AlojamientoId');
        select.disabled  = true;
        select.innerHTML = '<option value="">— Seleccioná las fechas primero —</option>';
        gid('disponibilidad-msg').textContent = '';
        capacidades         = {};
        _nombresDisponibles = {};
        _datosDisponibles   = [];
        sincronizarBotonAlojamiento();
        resetDownstreamDeAlojamiento();
        actualizarNochesYTotal();
        if (esGrupal) {
            actualizarAlertaGrupal();
            gid('lista-checkboxes-grupal').innerHTML = '';
        }
        if (gid('AlojamientoId').value && gid('CantidadHuespedes').value)
            consultarPrecioSugerido();
        renderCalendariosAire();
    });

    gid('FechaSalida').addEventListener('change', function () {
        actualizarNochesYTotal();
        buscarDisponibles();
        renderCalendariosAire();
    });

    gid('AlojamientoId').addEventListener('change', function () {
        actualizarCantidadState();
        actualizarPrecioState();
        gid('precio-hint').textContent = 'Buscando tarifa…';
        consultarPrecioSugerido();
        renderCalendariosAire();
    });

    gid('IncluyeDesayuno').addEventListener('change', function () {
        consultarPrecioSugerido();
    });

    gid('CantidadHuespedes').addEventListener('input', function () {
        const cap = getCapacidad();
        if (cap && parseInt(this.value) > cap) this.value = cap;
        if (parseInt(this.value) < 1 && this.value !== '') this.value = 1;
        actualizarPrecioState();
        clearTimeout(_debPrecio);
        _debPrecio = setTimeout(() => {
            gid('precio-hint').textContent = 'Buscando tarifa…';
            consultarPrecioSugerido();
        }, 400);
    });

    gid('PrecioPorDia').addEventListener('input', function () {
        // El precio por día siempre tiene prioridad: resetear cualquier edición
        // manual del total y recalcular automáticamente.
        totalFijo = false;
        gid('total-hint').textContent = 'Se calcula automáticamente (precio × noches)';
        actualizarNochesYTotal();
    });

    gid('MontoTotal').addEventListener('input', function () {
        totalFijo = true;
        const noches = calcularNoches();
        const total  = parseFloat(this.value);
        if (noches != null && noches > 0 && total > 0) {
            gid('PrecioPorDia').value = (total / noches).toFixed(2);
            gid('precio-hint').textContent = 'Calculado automáticamente (total ÷ noches)';
            gid('total-hint').textContent  = 'Total ingresado manualmente';
        } else {
            gid('PrecioPorDia').value = '';
            gid('total-hint').textContent = 'Total ingresado manualmente';
        }
        actualizarTotalFinalUI();
    });

    // ── Poblar hidden inputs grupal antes del submit ──────────────────────────
    function prepararCamposGrupal() {
        const container = gid('container-unidades-grupales');
        container.innerHTML = '';

        // Campo EsGrupal ya lo manda el checkbox nativo
        const ids = Object.keys(unidadesGrupales);
        ids.forEach((id, i) => {
            const u = unidadesGrupales[id];
            const mkInput = (name, value) => {
                const inp = document.createElement('input');
                inp.type  = 'hidden';
                inp.name  = name;
                inp.value = value;
                container.appendChild(inp);
            };
            mkInput(`UnidadesGrupales[${i}].AlojamientoId`,     id);
            mkInput(`UnidadesGrupales[${i}].CantidadHuespedes`, u.personas);
        });

        // Setear AlojamientoId (primer item) y CantidadHuespedes (suma)
        if (ids.length > 0) {
            const firstId   = ids[0];
            const totalPers = ids.reduce((s, id) => s + (unidadesGrupales[id]?.personas ?? 0), 0);
            // Inyectar en el select (siempre está en el DOM aunque oculto)
            let opt = gid('AlojamientoId').querySelector(`option[value="${firstId}"]`);
            if (!opt) {
                opt = document.createElement('option');
                opt.value = firstId;
                gid('AlojamientoId').appendChild(opt);
            }
            gid('AlojamientoId').value           = firstId;
            gid('CantidadHuespedes').disabled    = false;
            gid('CantidadHuespedes').value        = totalPers;
        }
    }

    // ── Modal de confirmación ─────────────────────────────────────────────────
    function formatFecha(val) {
        if (!val) return '—';
        const [y, m, d] = val.split('-');
        return `${d}/${m}/${y}`;
    }

    function poblarModalResumen() {
        gid('modal-confirmar-dialog').style.maxWidth = esGrupal ? '620px' : '480px';

        const ingreso  = gid('FechaIngreso').value;
        const egreso   = gid('FechaSalida').value;
        const noches   = calcularNoches();
        const esInv    = gid('EsInvitacion').checked;
        const montoAlojamientoActual = parseFloat(gid('MontoTotal').value) || 0;
        const total    = montoAlojamientoActual + calcularSubtotalAire();
        const telefono = gid('Telefono').value.trim();
        const canal    = gid('CanalOrigen').value;
        const obs      = gid('Observaciones').value.trim();
        const fmtNum   = n => n.toLocaleString('es-AR');

        let alojInfo, personasInfo, precioPorDiaInfo, totalInfo;

        if (esGrupal) {
            const ids = Object.keys(unidadesGrupales);

            // Mismo criterio que la lista de checkboxes: Habitaciones+Aparts a la
            // izquierda, Cabañas a la derecha.
            const idsIzq = ids.filter(id => unidadesGrupales[id].tipo !== 'Cabaña');
            const idsDer = ids.filter(id => unidadesGrupales[id].tipo === 'Cabaña');

            const fmtUnidad = id =>
                `<div><strong>${unidadesGrupales[id].nombre}</strong> <span class="fw-normal text-muted">(${unidadesGrupales[id].personas} pers.)</span></div>`;

            const fmtColumna = (titulo, idsCol) => idsCol.length === 0 ? '' : `
                <div class="flex-fill">
                    <div class="text-muted small mb-1">${titulo}</div>
                    ${idsCol.map(fmtUnidad).join('')}
                </div>`;

            const lineaSeparadora = `<div style="border-top:1px solid #dee2e6; width:100%; margin:.4rem 0;"></div>`;

            alojInfo = lineaSeparadora +
                `<div class="d-flex flex-column flex-sm-row gap-3 py-1">` +
                fmtColumna('Habitaciones y Aparts', idsIzq) +
                fmtColumna('Cabañas', idsDer) +
                `</div>` +
                lineaSeparadora;

            const totalPersonas = ids.reduce((s, id) => s + unidadesGrupales[id].personas, 0);
            personasInfo = `<strong>${totalPersonas} persona${totalPersonas !== 1 ? 's' : ''} en total</strong> ` +
                `<span class="fw-normal text-muted">(${ids.length} unidad${ids.length !== 1 ? 'es' : ''})</span>`;

            const precioPorDia = parseFloat(gid('PrecioPorDia').value) || 0;
            precioPorDiaInfo = `$${fmtNum(precioPorDia)} por día`;
            totalInfo = `<strong>$${fmtNum(total)}</strong> <span class="fw-normal text-muted">(total grupal)</span>`;
        } else {
            const alojSelect = gid('AlojamientoId');
            alojInfo    = alojSelect.selectedIndex >= 0
                ? `<strong>${alojSelect.options[alojSelect.selectedIndex].text}</strong>` : '—';
            const personas  = parseInt(gid('CantidadHuespedes').value) || 0;
            const precio    = parseFloat(gid('PrecioPorDia').value) || 0;
            personasInfo = personas > 0 ? `${personas} persona${personas !== 1 ? 's' : ''}` : '—';
            precioPorDiaInfo = esInv ? 'Invitación (sin costo)' : `$${fmtNum(precio)} por día`;
            totalInfo = `<strong>$${fmtNum(total)}</strong>${esInv ? ' <span class="text-muted">(Invitación)</span>' : ''}`;
        }

        const rows = [
            ['Titular',              `<strong>${gid('NombreHuesped').value.trim()}</strong>`],
            ['¿Es invitación?',      esInv ? 'Sí' : 'No'],
            ['¿Es grupal?',          esGrupal ? 'Sí' : 'No'],
            ['Fecha de ingreso',     `<strong>${formatFecha(ingreso)}</strong>`],
            ['Fecha de egreso',      `<strong>${formatFecha(egreso)}</strong>`],
            ['Cantidad de noches',   noches != null ? `${noches} noche${noches !== 1 ? 's' : ''}` : '—'],
            ['Alojamiento',          alojInfo],
            ['Cantidad de personas', personasInfo],
            ['Incluye desayuno',     gid('IncluyeDesayuno').checked ? 'Sí' : 'No'],
            ['Precio por día',       precioPorDiaInfo],
            ['Total de estadía',     totalInfo],
            ['Teléfono de contacto', telefono || 'Sin especificar'],
            ['Canal de origen',      canal    || 'Sin especificar'],
            ['Observaciones',        obs      || 'Sin observaciones'],
        ];

        gid('modal-resumen-reserva').innerHTML =
            `<table class="table table-sm table-borderless mb-0">` +
            rows.map(([label, value]) =>
                `<tr>
                    <td class="text-muted pe-3" style="white-space:nowrap;width:1%;font-size:.85rem;">${label}</td>
                    <td style="font-size:.9rem;">${value}</td>
                </tr>`
            ).join('') +
            `</table>`;
    }

    // ── Validación al enviar ──────────────────────────────────────────────────
    gid('form-reserva').addEventListener('submit', function (e) {
        const errores      = [];
        const esInvitacion = gid('EsInvitacion').checked;
        const ingreso      = gid('FechaIngreso').value;
        const egreso       = gid('FechaSalida').value;

        if (!gid('NombreHuesped').value.trim())
            errores.push('Nombre y apellido del titular — Obligatorio');

        if (!ingreso)
            errores.push('Fecha de ingreso — Obligatorio');

        if (!egreso)
            errores.push('Fecha de egreso — Obligatorio');
        else if (ingreso && egreso <= ingreso)
            errores.push('Fecha de egreso — Debe ser posterior a la fecha de ingreso');

        if (esGrupal) {
            const ids = Object.keys(unidadesGrupales);
            if (ids.length < 2)
                errores.push('Reserva grupal — Seleccioná al menos 2 unidades');
            else if (ids.some(id => !unidadesGrupales[id]?.personas))
                errores.push('Reserva grupal — Todas las unidades deben tener personas asignadas');
        } else {
            if (!gid('AlojamientoId').value)
                errores.push('Alojamiento — Obligatorio');

            const personas = parseInt(gid('CantidadHuespedes').value);
            const cap      = getCapacidad();
            if (!gid('CantidadHuespedes').value || personas < 1)
                errores.push('Cantidad de personas — Obligatorio');
            else if (cap && personas > cap)
                errores.push(`Cantidad de personas — Supera la capacidad máxima (${cap} personas)`);

            if (!esInvitacion) {
                if (!gid('PrecioPorDia').value || parseFloat(gid('PrecioPorDia').value) <= 0)
                    errores.push('Precio por día — Obligatorio');
            }
        }

        if (!esInvitacion) {
            if (!gid('MontoTotal').value || parseFloat(gid('MontoTotal').value) <= 0)
                errores.push('Total de la estadía — Obligatorio');
        }

        if (errores.length) {
            e.preventDefault();
            gid('lista-errores').innerHTML = errores.map(m => `<li>${m}</li>`).join('');
            gid('resumen-errores').classList.remove('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
        }

        // Preparar campos ocultos grupal antes del modal
        if (esGrupal) prepararCamposGrupal();
        prepararCamposAire();
        prepararCamposVinculo();

        e.preventDefault();
        poblarModalResumen();
        bootstrap.Modal.getOrCreateInstance(gid('modal-confirmar-reserva')).show();
    });

    gid('btn-confirmar-reserva').addEventListener('click', function () {
        bootstrap.Modal.getInstance(gid('modal-confirmar-reserva'))?.hide();
        const subtotalAire = calcularSubtotalAire();
        if (subtotalAire > 0) {
            const montoAlojamiento = parseFloat(gid('MontoTotal').value) || 0;
            gid('MontoTotal').value = (montoAlojamiento + subtotalAire).toFixed(2);
        }
        gid('PrecioPorDia').readOnly = false;
        gid('MontoTotal').readOnly   = false;
        gid('form-reserva').submit();
    });

    // ── Inicialización ────────────────────────────────────────────────────────
    (function init() {
        if (gid('EsInvitacion').checked) aplicarModoInvitacion(true);
        if (gid('EsGrupal').checked)     toggleModoGrupal(true);

        const ingreso = gid('FechaIngreso').value;
        const egreso  = gid('FechaSalida').value;

        if (ingreso) {
            const egresoInput = gid('FechaSalida');
            egresoInput.disabled = false;
            gid('egreso-hint').textContent = '';
            const minDate = new Date(ingreso + 'T00:00:00');
            minDate.setDate(minDate.getDate() + 1);
            egresoInput.min = minDate.toISOString().split('T')[0];
        }

        if (ingreso && egreso) buscarDisponibles();

        const noches = calcularNoches();
        if (noches != null)
            gid('noches-display').value = `${noches} noche${noches !== 1 ? 's' : ''}`;

        if (gid('MontoTotal').value) {
            habilitarCampo('MontoTotal');
            totalFijo = true;
            gid('total-hint').textContent = 'Total ingresado manualmente';
        }
    })();
    </script>
}
