@model ReservaViewModel
@{
    ViewData["Title"] = "Nueva Reserva";
    var prevAlojId  = Model.AlojamientoId?.ToString() ?? "";
    var fromCrear   = Context.Request.Query["from"].ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Nueva Reserva</h2>
    @if (fromCrear == "listado")
    {
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm btn-nav-crear">
            <span class="d-none d-md-inline">← Volver al listado de reservas</span>
            <span class="d-md-none">← Volver al listado</span>
        </a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm btn-nav-crear">
            Ir al listado de reservas →
        </a>
    }
</div>

<div id="resumen-errores" class="alert alert-danger d-none" role="alert">
    <strong>Corregí los siguientes errores antes de guardar:</strong>
    <ul class="mb-0 mt-1" id="lista-errores"></ul>
</div>

<form asp-action="Crear" method="post" id="form-reserva" novalidate>
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <strong>No se pudo guardar la reserva:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    @* ── Card 1: Datos del huésped ── *@
    <div class="card mb-3">
        <div class="card-header fw-semibold bg-light">Datos del titular</div>
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-md-7">
                    <label asp-for="NombreHuesped" class="form-label">
                        Nombre y apellido del titular <span class="text-danger">*</span>
                    </label>
                    <input asp-for="NombreHuesped" class="form-control" id="NombreHuesped"
                           placeholder="Ej: Juan García" />
                    <span asp-validation-for="NombreHuesped" class="text-danger small"></span>
                </div>
                <div class="col-md-5 pt-md-4">
                    <div class="form-check form-check-lg border rounded p-3">
                        <input asp-for="EsInvitacion" type="checkbox"
                               class="form-check-input" id="EsInvitacion" />
                        <label asp-for="EsInvitacion" class="form-check-label fw-semibold">
                            ¿Es invitación?
                            <span class="d-block text-muted fw-normal small">
                                El precio queda en $0. El total es editable por colaboración voluntaria.
                            </span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Card 2: Fechas de estadía ── *@
    <div class="card mb-3">
        <div class="card-header fw-semibold bg-light">Fechas de estadía</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="FechaIngreso" class="form-label">
                        Fecha de ingreso <span class="text-danger">*</span>
                    </label>
                    <input asp-for="FechaIngreso" type="date" class="form-control" id="FechaIngreso" />
                    <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="FechaSalida" class="form-label">
                        Fecha de egreso <span class="text-danger">*</span>
                    </label>
                    <input asp-for="FechaSalida" type="date" class="form-control"
                           id="FechaSalida" disabled />
                    <div class="form-text" id="egreso-hint">Seleccioná la fecha de ingreso primero</div>
                    <span asp-validation-for="FechaSalida" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted">Cantidad de noches</label>
                    <input type="text" class="form-control bg-light text-center fw-semibold"
                           id="noches-display" readonly placeholder="Automático" />
                    <div class="form-text">Calculado según las fechas</div>
                </div>
            </div>
        </div>
    </div>

    @* ── Card 3: Alojamiento ── *@
    <div class="card mb-3">
        <div class="card-header fw-semibold bg-light">Alojamiento</div>
        <div class="card-body">

            <div class="border rounded p-3 mb-3" id="bloque-toggle-grupal">
                <div class="form-check form-switch mb-0" id="bloque-toggle-grupal-switch">
                    <input asp-for="EsGrupal" type="checkbox" class="form-check-input" id="EsGrupal" role="switch" />
                </div>
                <div id="bloque-toggle-grupal-texto">
                    <label for="EsGrupal" class="fw-bold mb-0" style="cursor:pointer;">¿Es reserva grupal?</label>
                    <span class="d-block text-muted fw-normal small">
                        Permite asignar varias unidades de alojamiento a la misma reserva.
                    </span>
                </div>
            </div>

            <div id="seccion-individual">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label asp-for="AlojamientoId" class="form-label">
                            Alojamiento <span class="text-danger">*</span>
                        </label>
                        <div class="position-relative" id="AlojamientoId-wrapper">
                            <button type="button" class="form-select text-start" id="AlojamientoId-btn" disabled>
                                — Seleccioná las fechas primero —
                            </button>
                            <div class="custom-select-menu d-none" id="AlojamientoId-menu"></div>
                            <select asp-for="AlojamientoId" class="d-none" id="AlojamientoId" disabled>
                                <option value="">— Seleccioná las fechas primero —</option>
                            </select>
                        </div>
                        <div id="disponibilidad-msg" class="form-text"></div>
                        <span asp-validation-for="AlojamientoId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="CantidadHuespedes" class="form-label">
                            Cantidad de personas <span class="text-danger">*</span>
                        </label>
                        <input asp-for="CantidadHuespedes" type="number" class="form-control"
                               id="CantidadHuespedes" min="1" disabled />
                        <div id="capacidad-hint" class="form-text">Seleccioná un alojamiento primero</div>
                        <span asp-validation-for="CantidadHuespedes" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 d-flex align-items-center">
                        <div class="form-check">
                            <input asp-for="IncluyeDesayuno" type="checkbox"
                                   class="form-check-input" id="IncluyeDesayuno" />
                            <label asp-for="IncluyeDesayuno" class="form-check-label fw-normal">
                                ¿Incluye desayuno?
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div id="seccion-grupal" class="d-none">
                <div class="alert alert-warning py-2 px-3 mb-3 small" id="alerta-grupal-info">
                    <i class="bi bi-calendar-x me-1"></i>
                    Seleccioná primero las fechas de ingreso y egreso para poder elegir las unidades de la reserva grupal.
                </div>
                <div id="disponibilidad-msg-grupal" class="form-text mb-2"></div>
                <div id="lista-checkboxes-grupal"></div>
                <div id="resumen-grupal" class="mt-3 d-none">
                    <div class="d-flex gap-3 flex-wrap">
                        <span class="text-muted small">
                            Unidades seleccionadas: <strong id="grupal-cant-unidades">0</strong>
                        </span>
                        <span class="text-muted small">
                            Total personas: <strong id="grupal-total-personas">0</strong>
                        </span>
                    </div>
                </div>
                @* Campos ocultos que el JS completa antes del submit *@
                <div id="container-unidades-grupales"></div>
            </div>

            <div class="border rounded p-3 mb-3 mt-4" id="bloque-toggle-aire">
                <div class="form-check form-switch mb-0" id="bloque-toggle-aire-switch">
                    <input asp-for="UsaAireAcondicionado" type="checkbox" class="form-check-input" id="UsaAireAcondicionado" role="switch" />
                </div>
                <div id="bloque-toggle-aire-texto">
                    <label for="UsaAireAcondicionado" class="fw-bold mb-0" style="cursor:pointer;"><i class="bi bi-snow2 me-1"></i>¿Usa aire acondicionado adicional?</label>
                    <span class="d-block text-muted fw-normal small">
                        Permite cobrar un adicional diario por el uso extendido del aire acondicionado en cabañas.
                    </span>
                </div>
            </div>

            <div id="seccion-aire" class="d-none">
                <div id="alerta-aire-sin-cabanas" class="alert alert-warning py-2 px-3 mb-3 small d-none">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    El costo adicional de aire acondicionado aplica únicamente a <strong>CABAÑAS</strong> — esta reserva no incluye ninguna.
                </div>
                <div id="contenido-aire" class="d-none">
                    <div class="mb-3">
                        <label asp-for="PrecioAireDiario" class="form-label">Valor diario del adicional</label>
                        <div class="input-group" style="max-width:220px;">
                            <span class="input-group-text">$</span>
                            <input asp-for="PrecioAireDiario" type="number" step="0.01" min="0" class="form-control" id="PrecioAireDiario" placeholder="0,00" />
                        </div>
                    </div>
                    <div id="calendarios-aire-por-cabana"></div>
                    <div id="resumen-aire" class="mt-3 p-2 rounded" style="background-color:#f8f9fa; border-left:3px solid #6c757d; font-size:.85rem;"></div>
                </div>
            </div>

        </div>
    </div>

    @* ── Card 3.5: Reservas vinculadas ── *@
    <div class="card mb-3">
        <div class="card-body">
            <div class="border rounded p-3 mb-3" id="bloque-toggle-vinculo">
                <div class="form-check form-switch mb-0" id="bloque-toggle-vinculo-switch">
                    <input type="checkbox" class="form-check-input" id="UsarVinculo" role="switch" />
                </div>
                <div id="bloque-toggle-vinculo-texto">
                    <label for="UsarVinculo" class="fw-bold mb-0" style="cursor:pointer;"><i class="bi bi-link-45deg me-1"></i>¿Vincular con otra reserva?</label>
                    <span class="d-block text-muted fw-normal small">
                        Conecta esta reserva con otras independientes (mismo huésped que se mudó de alojamiento, o parte de un mismo grupo/evento), sin fusionar su facturación.
                    </span>
                </div>
            </div>

            <div id="seccion-vinculo" class="d-none">
                <div class="mb-3">
                    <label for="buscar-reserva-vincular" class="form-label">Buscar reserva para vincular</label>
                    <div class="position-relative">
                        <input type="text" id="buscar-reserva-vincular" class="form-control"
                               placeholder="Nombre del titular a buscar" autocomplete="off" />
                    </div>
                    <div class="form-text">Buscá por nombre y seleccioná la reserva a vincular.</div>
                </div>

                <div id="lista-vinculadas" class="mb-3"></div>

                <div class="mb-2">
                    <label for="EtiquetaGrupoVinculado" class="form-label">Etiqueta del grupo <span class="text-muted fw-normal">(opcional)</span></label>
                    <input type="text" id="EtiquetaGrupoVinculado" name="EtiquetaGrupoVinculado"
                           class="form-control" placeholder="Nombre descriptivo del grupo" maxlength="100" />
                    <div class="form-text">Si dejás esto vacío, el sistema muestra automáticamente el alojamiento o el nombre del titular vinculado.</div>
                </div>
            </div>

            <div id="container-vinculo"></div>
        </div>
    </div>

    @* ── Card 4: Precios ── *@
    <div class="card mb-3">
        <div class="card-header fw-semibold bg-light">Precios</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="PrecioPorDia" class="form-label">
                        Precio por día <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PrecioPorDia" type="number" step="0.01" min="0"
                               class="form-control campo-inactivo" id="PrecioPorDia"
                               placeholder="0,00" readonly />
                    </div>
                    <div class="form-text" id="precio-hint">
                        Completá alojamiento y personas para habilitar
                    </div>
                    <span asp-validation-for="PrecioPorDia" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MontoTotal" class="form-label">
                        Total de la estadía <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="MontoTotal" type="number" step="0.01" min="0"
                               class="form-control campo-inactivo" id="MontoTotal"
                               placeholder="0,00" readonly />
                    </div>
                    <div class="form-text" id="total-hint">
                        Se calcula automáticamente (precio × noches)
                    </div>
                    <span asp-validation-for="MontoTotal" class="text-danger small"></span>
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <div class="alert alert-info py-2 px-3 mb-0 small w-100">
                        <strong>Bidireccional:</strong> ingresá el precio por día <em>o</em> el total directamente. El otro campo se recalcula automáticamente según las noches de estadía.
                    </div>
                </div>
                <div id="desglose-aire" class="col-12">
                    <div class="alert alert-light border py-2 px-3 mb-2 small">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-uppercase" style="letter-spacing:.03em;">
                                Total aire acondicionado adicional (<span id="desglose-dias-aire">0</span> días)
                            </span>
                            <strong class="fs-6 fw-bold" id="desglose-monto-aire">$0</strong>
                        </div>
                    </div>
                    <div class="p-3 rounded text-white" style="background-color:#0d6efd;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-uppercase" style="letter-spacing:.04em;">Total final a cobrar</span>
                            <span class="fw-bold fs-4" id="desglose-total-final">$0</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Card 5: Información adicional (opcional) ── *@
    <div class="card mb-4">
        <div class="card-header fw-semibold bg-light">Información adicional <span class="text-muted fw-normal small">(opcional)</span></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Telefono" class="form-label">Teléfono de contacto</label>
                    <input asp-for="Telefono" type="tel" class="form-control"
                           placeholder="+54 9 354 000-0000" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CanalOrigen" class="form-label">Canal de origen</label>
                    <select asp-for="CanalOrigen" class="form-select">
                        <option value="">— Sin especificar —</option>
                        <option value="WhatsApp">WhatsApp</option>
                        <option value="Página web">Página web</option>
                        <option value="Recomendación">Recomendación</option>
                        <option value="De paso">De paso</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label asp-for="Observaciones" class="form-label">Observaciones</label>
                    <textarea asp-for="Observaciones" class="form-control" rows="2"
                              placeholder="Sin observaciones"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div id="botones-crear" class="d-flex gap-2 mb-5">
        <button type="submit" class="btn btn-primary px-4">Guardar Reserva</button>
        <a asp-action="Index" class="btn btn-modal-cancelar">Cancelar</a>
    </div>
</form>

<style>
    .campo-inactivo {
        background-color: #e9ecef !important;
        cursor: not-allowed;
    }
    #bloque-toggle-grupal {
        display: flex !important;
        align-items: center !important;
        justify-content: flex-start !important;
        gap: .75rem !important;
        flex-wrap: nowrap !important;
        overflow: hidden !important;
        background-color: #f8f9fc;
        border-color: #cdd6f4 !important;
        transition: background-color .15s ease, border-color .15s ease;
    }
    #bloque-toggle-grupal:has(#EsGrupal:checked) {
        background-color: #eaf0ff;
        border-color: #6c8eef !important;
    }
    #bloque-toggle-grupal-texto {
        min-width: 0 !important;
        flex: 1 1 auto !important;
    }
    #bloque-toggle-grupal-switch {
        flex: 0 0 auto !important;
        padding-left: 2.5em !important;
        margin: 0 !important;
    }
    #bloque-toggle-grupal-switch .form-check-input {
        margin-left: -2.5em !important;
        float: none !important;
    }
    #bloque-toggle-aire {
        display: flex !important;
        align-items: center !important;
        justify-content: flex-start !important;
        gap: .75rem !important;
        flex-wrap: nowrap !important;
        overflow: hidden !important;
        background-color: #f8f9fc;
        border-color: #cdd6f4 !important;
        transition: background-color .15s ease, border-color .15s ease;
    }
    #bloque-toggle-aire:has(#UsaAireAcondicionado:checked) {
        background-color: #eaf0ff;
        border-color: #6c8eef !important;
    }
    #bloque-toggle-aire-texto {
        min-width: 0 !important;
        flex: 1 1 auto !important;
    }
    #bloque-toggle-aire-switch {
        flex: 0 0 auto !important;
        padding-left: 2.5em !important;
        margin: 0 !important;
    }
    #bloque-toggle-aire-switch .form-check-input {
        margin-left: -2.5em !important;
        float: none !important;
    }
    #lista-checkboxes-grupal .grid-checkboxes-grupal {
        display: flex;
        flex-direction: column;
        gap: 0;
    }
    @@media (min-width: 576px) {
        #lista-checkboxes-grupal .grid-checkboxes-grupal { flex-direction: row; column-gap: 2rem; }
        #lista-checkboxes-grupal .columna-grupal { flex: 1 1 0; min-width: 0; }
    }
    .columna-grupal-titulo {
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #6c757d;
        margin-bottom: .25rem;
        margin-top: .5rem;
    }
    .columna-grupal-titulo:first-child { margin-top: 0; }
    .grupal-item { border-bottom: 1px solid #e9ecef; }
    #AlojamientoId-btn {
        cursor: pointer;
    }
    #AlojamientoId-btn:disabled {
        cursor: not-allowed;
    }
    .custom-select-menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        max-height: 240px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #ced4da;
        border-radius: .375rem;
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
        margin-top: 2px;
    }
    .custom-select-menu .custom-select-item {
        padding: .5rem .75rem;
        cursor: pointer;
        font-size: .95rem;
    }
    .custom-select-menu .custom-select-item:hover,
    .custom-select-menu .custom-select-item.active {
        background-color: #e9ecef;
    }
    .custom-select-menu .custom-select-item.placeholder {
        color: #6c757d;
    }
    @@media (max-width: 767.98px) {
        /* Botón superior: contenido centrado */
        .btn-nav-crear { display: flex !important; align-items: center !important; justify-content: center !important; }
        /* Botones inferiores: centrados horizontalmente, contenido centrado */
        #botones-crear { justify-content: center !important; }
        #botones-crear .btn { display: flex !important; align-items: center !important; justify-content: center !important; }
        /* Modal de confirmación: altura adaptada al contenido */
        #modal-confirmar-reserva .modal-content { height: auto !important; min-height: unset !important; }
        #modal-confirmar-reserva .modal-footer { padding-bottom: 1rem !important; }
        /* Modal de personas por unidad: altura adaptada al contenido */
        #modal-personas-unidad .modal-content { height: auto !important; min-height: unset !important; max-height: 90vh !important; }
        /* Campos de fecha de estadía: centrar verticalmente */
        #FechaIngreso, #FechaSalida { display: flex !important; align-items: center !important; }
        #FechaIngreso::-webkit-datetime-edit, #FechaSalida::-webkit-datetime-edit,
        #FechaIngreso::-webkit-datetime-edit-fields-wrapper, #FechaSalida::-webkit-datetime-edit-fields-wrapper { padding: 0 !important; }
        /* Columna Cabañas: separación superior en mobile (modo apilado) */
        #lista-checkboxes-grupal .columna-grupal + .columna-grupal { margin-top: 1rem !important; }
    }
    @@media (min-width: 769px) {
        #botones-crear { justify-content: center !important; }
    }
    #bloque-toggle-vinculo {
        display: flex !important; align-items: center !important;
        justify-content: flex-start !important; gap: .75rem !important;
        flex-wrap: nowrap !important; overflow: hidden !important;
        background-color: #f8f9fc; border-color: #cdd6f4 !important;
        transition: background-color .15s ease, border-color .15s ease;
    }
    #bloque-toggle-vinculo:has(#UsarVinculo:checked) { background-color: #eaf0ff; border-color: #6c8eef !important; }
    #bloque-toggle-vinculo-texto { min-width: 0 !important; flex: 1 1 auto !important; }
    #bloque-toggle-vinculo-switch { flex: 0 0 auto !important; padding-left: 2.5em !important; margin: 0 !important; }
    #bloque-toggle-vinculo-switch .form-check-input { margin-left: -2.5em !important; float: none !important; }
    .vinculo-ac-dropdown {
        position: absolute; top: 100%; left: 0; right: 0; z-index: 1050;
        background: #fff; border: 1px solid #ced4da; border-top: none;
        border-radius: 0 0 .375rem .375rem; max-height: 280px; overflow-y: auto;
        display: none; box-shadow: 0 4px 8px rgba(0,0,0,.08); padding: 0; margin: 0;
    }
    .vinculo-ac-dropdown li {
        padding: .5rem .75rem; font-size: .875rem; cursor: pointer; list-style: none;
        border-bottom: 1px solid #f1f3f5;
    }
    .vinculo-ac-dropdown li:last-child { border-bottom: none; }
    .vinculo-ac-dropdown li:hover,
    .vinculo-ac-dropdown li.ac-active { background-color: #e9f0ff; }
    .vinculo-ac-dropdown li .vinculo-tipo-badge {
        font-size: .72rem; color: #6c757d; margin-left: .35rem;
    }
    .vinculada-item {
        display: flex; align-items: center; justify-content: space-between;
        padding: .5rem .75rem; border: 1px solid #dee2e6; border-radius: .375rem;
        margin-bottom: .4rem; background-color: #fff;
    }
    .vinculada-item .vinculada-info { font-size: .875rem; }
    .vinculada-item .vinculada-info .text-muted { font-size: .8rem; }
</style>

@* ── Modal personas por unidad (reserva grupal) ── *@
<div class="modal fade" id="modal-personas-unidad" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title fw-semibold" id="modal-personas-titulo">Personas en la unidad</h6>
                <button type="button" class="btn-close" id="btn-cerrar-modal-personas"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2" id="modal-personas-capacidad"></p>
                <label class="form-label fw-semibold">¿Cuántas personas se alojan acá?</label>
                <input type="number" id="input-personas-modal" class="form-control form-control-lg"
                       min="1" placeholder="0" />
                <div id="modal-personas-error" class="text-danger small mt-1 d-none"></div>
            </div>
            <div class="modal-footer py-2 gap-2 justify-content-center">
                <button type="button" class="btn btn-modal-cancelar btn-sm" id="btn-cancelar-personas">Cancelar</button>
                <button type="button" class="btn btn-primary btn-sm px-4" id="btn-confirmar-personas">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@* ── Modal de confirmación ── *@
<div class="modal fade" id="modal-confirmar-reserva" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" id="modal-confirmar-dialog" style="max-width:480px;">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title fw-semibold">
                    <i class="bi bi-check2-circle me-2 text-success"></i>Confirmar nueva reserva
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pb-1">
                <div id="modal-resumen-reserva"></div>
            </div>
            <div class="modal-footer py-2 gap-2 justify-content-center">
                <button type="button" class="btn btn-modal-volver" data-bs-dismiss="modal">
                    <i class="bi bi-arrow-left me-1"></i>Volver y corregir
                </button>
                <button type="button" class="btn btn-primary px-4" id="btn-confirmar-reserva">
