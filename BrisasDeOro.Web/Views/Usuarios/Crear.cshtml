@model CrearUsuarioViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Nuevo usuario</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver al listado
    </a>
</div>

<div class="card" style="max-width: 540px;">
    <div class="card-body">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <strong>Corregí los siguientes errores:</strong>
                <ul class="mb-0 mt-1">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Crear" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="UserName" class="form-label">
                    Nombre de usuario <span class="text-danger">*</span>
                </label>
                <input asp-for="UserName" class="form-control" placeholder="ej: maria.gonzalez" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    Contraseña <span class="text-danger">*</span>
                </label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">
                    Confirmar contraseña <span class="text-danger">*</span>
                </label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Número de celular</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="ej: 11 1234-5678" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Rol" class="form-label">
                    Rol <span class="text-danger">*</span>
                </label>
                <select asp-for="Rol" class="form-select">
                    @if (Model.Rol == "Administrador")
                    {
                        <option value="Administrador" selected>Administrador</option>
                        <option value="Viewer">Viewer</option>
                    }
                    else
                    {
                        <option value="Administrador">Administrador</option>
                        <option value="Viewer" selected>Viewer</option>
                    }
                </select>
                <div class="form-text text-muted">
                    <strong>Administrador:</strong> acceso completo.
                    <strong>Viewer:</strong> solo lectura.
                </div>
                <span asp-validation-for="Rol" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i>Crear usuario
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
