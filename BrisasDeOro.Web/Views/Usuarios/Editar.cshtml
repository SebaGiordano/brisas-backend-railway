@model EditarUsuarioViewModel
@{
    ViewData["Title"] = $"Editar usuario — {Model.UserName}";
}

<style>
    @@media (max-width: 767.98px) {
        #btn-volver-editar-usr,
        #btn-cancelar-editar-usr,
        #btns-editar-usr .btn {
            display: flex !important; align-items: center !important; justify-content: center !important;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Editar usuario</h2>
    <a id="btn-volver-editar-usr" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver al listado
    </a>
</div>

<div class="card" style="max-width: 540px;">
    <div class="card-body">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <strong>Corregí los siguientes errores:</strong>
                <ul class="mb-0 mt-1">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Editar" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="UserName" class="form-label">Nombre de usuario</label>
                <input asp-for="UserName" class="form-control" />
                <div class="form-text text-muted">Es el nombre con el que se ingresa al sistema.</div>
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Número de celular</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="ej: 11 1234-5678" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Rol" class="form-label">
                    Rol <span class="text-danger">*</span>
                </label>
                <select asp-for="Rol" class="form-select">
                    @if (Model.Rol == "Administrador")
                    {
                        <option value="Administrador" selected>Administrador</option>
                        <option value="Viewer">Viewer</option>
                    }
                    else
                    {
                        <option value="Administrador">Administrador</option>
                        <option value="Viewer" selected>Viewer</option>
                    }
                </select>
                <div class="form-text text-muted">
                    <strong>Administrador:</strong> acceso completo.
                    <strong>Viewer:</strong> solo lectura.
                </div>
                <span asp-validation-for="Rol" class="text-danger small"></span>
            </div>

            <hr class="my-4" />

            <h6 class="mb-3">Cambiar contraseña <span class="text-muted fw-normal">(opcional)</span></h6>

            <div class="mb-3">
                <label asp-for="NuevaPassword" class="form-label">Nueva contraseña</label>
                <div class="input-group">
                    <input asp-for="NuevaPassword" type="password" class="form-control" autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary btn-toggle-password" tabindex="-1" aria-label="Mostrar contraseña">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label asp-for="ConfirmarNuevaPassword" class="form-label">Confirmar nueva contraseña</label>
                <div class="input-group">
                    <input asp-for="ConfirmarNuevaPassword" type="password" class="form-control" autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary btn-toggle-password" tabindex="-1" aria-label="Mostrar contraseña">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmarNuevaPassword" class="text-danger small"></span>
            </div>

            <div class="form-text text-muted mb-4">
                Dejalo vacío para mantener la contraseña actual. Mínimo 6 caracteres, con al menos un número y una letra minúscula.
            </div>

            <div id="btns-editar-usr" class="d-flex gap-2 justify-content-center">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i>Guardar cambios
                </button>
                <a id="btn-cancelar-editar-usr" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
