<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BrisasDeOro.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BrisasDeOro.Web.styles.css" asp-append-version="true" />
    <style>
        .navbar-nav { align-items: center; }
        /* Botón Salir: hover y active en rojo */
        .btn-salir:hover, .btn-salir:active, .btn-salir:focus {
            background-color: #dc3545 !important;
            border-color: #dc3545 !important;
            color: #fff !important;
        }
        header .navbar .navbar-nav .nav-link.active {
            background-color: #0d6efd !important;
            color: #fff !important;
            border-radius: 6px !important;
            font-weight: 600 !important;
            padding: .35rem 1rem !important;
            line-height: 1.5 !important;
        }
        header .navbar .navbar-nav .nav-link:not(.active):hover {
            font-weight: 600 !important;
        }
        .navbar { overflow: hidden; min-height: unset; }
        .navbar .navbar-brand, .navbar .nav-link, .navbar .navbar-toggler { padding-top: 0; padding-bottom: 0; }
        body { padding-top: 90px; }
        @@media (max-width: 575.98px) { body { padding-top: 60px; } }
        @@media (max-width: 767.98px) {
            footer .container { white-space: normal !important; word-wrap: break-word !important; text-align: center !important; }
            /* 5px extra de separación entre el navbar y el contenido en mobile */
            body > .container { padding-top: 12px !important; }
        }
    </style>
</head>
<body>
    <header>
        @{
            var _ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            var _act  = ViewContext.RouteData.Values["action"]?.ToString()     ?? "";

            string Activo(string ctrl, string? act = null)
            {
                bool match = _ctrl.Equals(ctrl, StringComparison.OrdinalIgnoreCase)
                          && (act == null || _act.Equals(act, StringComparison.OrdinalIgnoreCase));
                return match ? " active" : "";
            }

            // "Reservas" se activa en cualquier acción de Reservas excepto Crear
            string ActivoReservas() =>
                _ctrl.Equals("Reservas", StringComparison.OrdinalIgnoreCase)
             && !_act.Equals("Crear",    StringComparison.OrdinalIgnoreCase)
                    ? " active" : "";
        }
        <nav class="navbar navbar-expand-xl navbar-toggleable-xl navbar-light bg-white border-bottom box-shadow mb-3 fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Inicio" asp-action="Index">
                    <img src="~/images/logo.png" height="50" width="auto" alt="Brisas de Oro" style="height:50px; width:auto; object-fit:contain; display:block;" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-xl-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark nav-link-stable@(Activo("Inicio"))" asp-controller="Inicio" asp-action="Index">
                                <span class="nav-link-text">Inicio</span>
                                <span class="nav-link-ghost" aria-hidden="true">Inicio</span>
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-stable@(Activo("Dashboard"))" asp-controller="Dashboard" asp-action="Index">
                                    <span class="nav-link-text">Dashboard</span>
                                    <span class="nav-link-ghost" aria-hidden="true">Dashboard</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador") || User.IsInRole("Viewer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-stable@(Activo("Calendario"))" asp-controller="Calendario" asp-action="Index">
                                    <span class="nav-link-text">Calendario</span>
                                    <span class="nav-link-ghost" aria-hidden="true">Calendario</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador") || User.IsInRole("Viewer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-stable@(ActivoReservas())" asp-controller="Reservas" asp-action="Index">
                                    <span class="nav-link-text">Reservas</span>
                                    <span class="nav-link-ghost" aria-hidden="true">Reservas</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador") || User.IsInRole("Viewer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-stable@(Activo("Facturacion"))" asp-controller="Facturacion" asp-action="Index">
                                    <span class="nav-link-text">Facturación</span>
                                    <span class="nav-link-ghost" aria-hidden="true">Facturación</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador") || User.IsInRole("Viewer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-stable@(Activo("Alojamientos"))" asp-controller="Alojamientos" asp-action="Index">
                                    <span class="nav-link-text">Alojamientos</span>
                                    <span class="nav-link-ghost" aria-hidden="true">Alojamientos</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-stable@(Activo("Tarifas"))" asp-controller="Tarifas" asp-action="Index">
                                    <span class="nav-link-text">Tarifas</span>
                                    <span class="nav-link-ghost" aria-hidden="true">Tarifas</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-stable@(Activo("Usuarios"))" asp-controller="Usuarios" asp-action="Index">
                                    <span class="nav-link-text">Usuarios</span>
                                    <span class="nav-link-ghost" aria-hidden="true">Usuarios</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold nav-link-stable@(Activo("Reservas", "Crear"))" asp-controller="Reservas" asp-action="Crear">
                                    <span class="nav-link-text">+ Nueva Reserva</span>
                                    <span class="nav-link-ghost" aria-hidden="true">+ Nueva Reserva</span>
                                </a>
                            </li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small fw-bold">@User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary btn-sm fw-bold btn-salir">Salir</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            <span class="d-none d-md-inline">&copy; 2026 Brisas de Oro &middot; Hotel y Cabañas &middot; Todos los derechos reservados</span>
            <span class="d-md-none">&copy; 2026 Brisas de Oro &middot; Todos los derechos reservados</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
    (function () {
        if (!('ontouchstart' in window)) return;
        var links = document.querySelectorAll('.navbar-collapse .navbar-nav .nav-link');
        links.forEach(function (link) {
            link.addEventListener('touchstart', function () {
                links.forEach(function (l) {
                    l.classList.remove('active');
                    l.classList.remove('nav-tap-active');
                });
                link.classList.add('nav-tap-active');
            }, { passive: true });
        });
    })();
    </script>
</body>
</html>
